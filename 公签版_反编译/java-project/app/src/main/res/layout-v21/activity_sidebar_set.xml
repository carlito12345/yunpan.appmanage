<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_left"
        android:background="#5002d769"
        android:layout_width="@dimen/dp_30"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="#ffffff"
        android:gravity="center"
        android:background="@drawable/bg_btn2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="触\10发\10区\10宽\10度"
        app:layout_constraintBottom_toBottomOf="@+id/v_left"
        app:layout_constraintEnd_toEndOf="@+id/v_left"
        app:layout_constraintStart_toStartOf="@+id/v_left"
        app:layout_constraintTop_toTopOf="@+id/v_left"/>
    <View
        android:id="@+id/v_right"
        android:background="#5002d769"
        android:layout_width="@dimen/dp_30"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="#ffffff"
        android:gravity="center"
        android:background="@drawable/bg_btn2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="触\10发\10区\10宽\10度"
        app:layout_constraintBottom_toBottomOf="@+id/v_right"
        app:layout_constraintEnd_toEndOf="@+id/v_right"
        app:layout_constraintStart_toStartOf="@+id/v_right"
        app:layout_constraintTop_toTopOf="@+id/v_right"/>
    <View
        android:id="@+id/v_bottom"
        android:background="#5002d769"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="#ffffff"
        android:gravity="center"
        android:background="@drawable/bg_btn2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="触发区高度"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toEndOf="@+id/v_bottom"
        app:layout_constraintStart_toStartOf="@+id/v_bottom"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_lay_bottom"
        android:background="#60000000"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/v_bottom"
        app:layout_constraintEnd_toStartOf="@+id/v_right"
        app:layout_constraintStart_toEndOf="@+id/v_left">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/btn_text_color1"
            android:gravity="center"
            android:id="@+id/v_btn_return"
            android:background="@drawable/bg_btn2"
            android:padding="@dimen/dp_16"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/dp_110"
            android:layout_height="wrap_content"
            android:text="返回"
            android:layout_marginStart="@dimen/dp_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/btn_text_color1"
            android:gravity="center"
            android:id="@+id/v_btn_yes"
            android:background="@drawable/bg_btn2"
            android:padding="@dimen/dp_16"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/dp_110"
            android:layout_height="wrap_content"
            android:text="确定"
            android:layout_marginEnd="@dimen/dp_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:scrollbarThumbVertical="@drawable/scrollbar1"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/v_scroll"
        android:background="@drawable/shape_no_focus"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dp_6"
        android:fadeScrollbars="false"
        app:layout_constraintBottom_toTopOf="@+id/v_lay_bottom"
        app:layout_constraintEnd_toStartOf="@+id/v_right"
        app:layout_constraintStart_toEndOf="@+id/v_left"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_50"
            android:layout_marginEnd="@dimen/dp_50">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.2"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/guideline2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.8"/>
            <ImageView
                android:id="@+id/v_left_on"
                android:clickable="true"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_25"
                android:src="@drawable/tp_on"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启用左侧："
                app:layout_constraintBottom_toBottomOf="@+id/v_left_on"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_left_on"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/btn_text_color1"
                android:gravity="center"
                android:id="@+id/v_left_split"
                android:background="@drawable/bg_btn2"
                android:clickable="true"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:text="1"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toBottomOf="@+id/v_left_on"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="左侧分段："
                app:layout_constraintBottom_toBottomOf="@+id/v_left_split"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_left_split"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/v_left_size"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:progressBackgroundTint="@color/color_8"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toBottomOf="@+id/v_left_split"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="左侧宽度："
                app:layout_constraintBottom_toBottomOf="@+id/v_left_size"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_left_size"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/v_left_top"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:progressBackgroundTint="@color/color_8"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toBottomOf="@+id/v_left_size"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="顶部距离："
                app:layout_constraintBottom_toBottomOf="@+id/v_left_top"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_left_top"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/v_left_bottom"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:progressBackgroundTint="@color/color_8"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toBottomOf="@+id/v_left_top"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="底部距离："
                app:layout_constraintBottom_toBottomOf="@+id/v_left_bottom"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_left_bottom"/>
            <ImageView
                android:id="@+id/v_right_on"
                android:clickable="true"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_26"
                android:src="@drawable/tp_on"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toBottomOf="@+id/v_left_bottom"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启用右侧："
                app:layout_constraintBottom_toBottomOf="@+id/v_right_on"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_right_on"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/btn_text_color1"
                android:gravity="center"
                android:id="@+id/v_right_split"
                android:background="@drawable/bg_btn2"
                android:clickable="true"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:text="1"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toBottomOf="@+id/v_right_on"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="右侧分段："
                app:layout_constraintBottom_toBottomOf="@+id/v_right_split"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_right_split"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/v_right_size"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:progressBackgroundTint="@color/color_8"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toBottomOf="@+id/v_right_split"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="右侧宽度："
                app:layout_constraintBottom_toBottomOf="@+id/v_right_size"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_right_size"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/v_right_top"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:progressBackgroundTint="@color/color_8"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toBottomOf="@+id/v_right_size"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="顶部距离："
                app:layout_constraintBottom_toBottomOf="@+id/v_right_top"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_right_top"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/v_right_bottom"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:progressBackgroundTint="@color/color_8"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toBottomOf="@+id/v_right_top"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="底部距离："
                app:layout_constraintBottom_toBottomOf="@+id/v_right_bottom"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_right_bottom"/>
            <ImageView
                android:id="@+id/v_bottom_on"
                android:clickable="true"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_26"
                android:src="@drawable/tp_on"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toBottomOf="@+id/v_right_bottom"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启用底部："
                app:layout_constraintBottom_toBottomOf="@+id/v_bottom_on"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_bottom_on"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/btn_text_color1"
                android:gravity="center"
                android:id="@+id/v_bottom_split"
                android:background="@drawable/bg_btn2"
                android:clickable="true"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:text="1"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toBottomOf="@+id/v_bottom_on"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="底部分段："
                app:layout_constraintBottom_toBottomOf="@+id/v_bottom_split"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_bottom_split"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/v_bottom_size"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:progressBackgroundTint="@color/color_8"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toBottomOf="@+id/v_bottom_split"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="底部高度："
                app:layout_constraintBottom_toBottomOf="@+id/v_bottom_size"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_bottom_size"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/v_bottom_left"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:progressBackgroundTint="@color/color_8"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toBottomOf="@+id/v_bottom_size"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="左边距离："
                app:layout_constraintBottom_toBottomOf="@+id/v_bottom_left"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_bottom_left"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/v_bottom_right"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_8"
                android:progressBackgroundTint="@color/color_8"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toBottomOf="@+id/v_bottom_left"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="右边距离："
                app:layout_constraintBottom_toBottomOf="@+id/v_bottom_right"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_bottom_right"/>
            <ImageView
                android:id="@+id/v_on_show_view"
                android:clickable="true"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_32"
                android:src="@drawable/tp_on"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toBottomOf="@+id/v_bottom_right"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="显示触发区域："
                app:layout_constraintBottom_toBottomOf="@+id/v_on_show_view"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_on_show_view"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_2"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(方便测试)"
                app:layout_constraintBottom_toBottomOf="@+id/v_on_show_view"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_on_show_view"/>
            <ImageView
                android:id="@+id/v_on_up_trigger"
                android:clickable="true"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_26"
                android:src="@drawable/tp_off"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toBottomOf="@+id/v_on_show_view"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="松开时再触发："
                app:layout_constraintBottom_toBottomOf="@+id/v_on_up_trigger"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_on_up_trigger"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_2"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="滑动后等手指离开屏幕时，再触发操作"
                app:layout_constraintBottom_toBottomOf="@+id/v_on_up_trigger"
                app:layout_constraintStart_toEndOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_on_up_trigger"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/btn_text_color1"
                android:gravity="center"
                android:id="@+id/v_trigger_effect"
                android:background="@drawable/bg_btn2"
                android:clickable="true"
                android:layout_width="@dimen/dp_180"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_26"
                android:text="特效一"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintTop_toBottomOf="@+id/v_on_up_trigger"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="#ffffff"
                android:gravity="end|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="边缘触摸动画："
                app:layout_constraintBottom_toBottomOf="@+id/v_trigger_effect"
                app:layout_constraintEnd_toStartOf="@+id/guideline"
                app:layout_constraintTop_toTopOf="@+id/v_trigger_effect"/>
            <View
