<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/dp_18"/>
            <solid android:color="@color/color_7"/>
            <stroke
                android:width="@dimen/dp_1"
                android:color="#ffd700"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <corners android:radius="@dimen/dp_18"/>
            <solid android:color="@color/color_9"/>
            <stroke
                android:width="@dimen/dp_1"
                android:color="@color/color_7"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/dp_18"/>
            <solid android:color="#ffffff"/>
            <stroke
                android:width="@dimen/dp_1"
                android:color="#fa4200"/>
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape>
            <corners android:radius="@dimen/dp_18"/>
            <solid android:color="#663d3d3d"/>
            <stroke
                android:width="@dimen/dp_1"
                android:color="#56ffffff"/>
        </shape>
    </item>
</selector>
