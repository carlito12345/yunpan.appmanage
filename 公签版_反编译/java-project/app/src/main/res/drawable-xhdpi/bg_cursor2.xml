<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/dp_500"/>
            <solid android:color="@color/color_2"/>
            <stroke
                android:width="@dimen/dp_4"
                android:color="#ffff0000"/>
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape>
            <corners android:radius="@dimen/dp_500"/>
            <solid android:color="#503d3d3d"/>
            <stroke
                android:width="@dimen/dp_4"
                android:color="#ffffff"/>
            <gradient
                android:startColor="@color/color_7"
                android:endColor="@color/color_12"
                android:angle="45"
                android:centerColor="@color/color_8"/>
        </shape>
    </item>
</selector>
