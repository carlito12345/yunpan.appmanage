<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:paddingBottom="@dimen/dp_15"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_15"
        android:paddingEnd="@dimen/dp_15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/v_top_ico"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_23"
            android:src="@drawable/wxts"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffff00"
            android:gravity="center"
            android:id="@+id/v_text_one"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:maxWidth="@dimen/dp_600"
            android:text="修改系统时间需要root权限，一般应用是无权限修改的(包括adb)"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_top_ico"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_2"
            android:gravity="center"
            android:id="@+id/v_text_two"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_3"
            android:maxWidth="@dimen/dp_600"
            android:text="注意：如果您的系统时间没问题的话，请不要尝试修改"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_text_one"/>
        <View
            android:id="@+id/v_view"
            android:background="#aaaaaa"
            android:focusable="false"
            android:layout_width="@dimen/dp_333"
            android:layout_height="@dimen/dp_2"
            android:layout_margin="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_text_two"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/btn_text_color1"
            android:gravity="center"
            android:id="@+id/v_btn_ntp1"
            android:background="@drawable/bg_btn1"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="方法一：同步国家NTP，同步北京时间，关闭地区同步"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_view"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/btn_text_color1"
            android:gravity="center"
            android:id="@+id/v_btn_ntp2"
            android:background="@drawable/bg_btn1"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="方法二：同步阿里NTP，同步北京时间，关闭地区同步"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_btn_ntp1"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/btn_text_color1"
            android:gravity="center"
            android:id="@+id/v_btn_http"
            android:background="@drawable/bg_btn1"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="方法三：关闭同步时间/地区，联网读取时间后修改(需root/公签)"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_btn_ntp2"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/btn_text_color1"
            android:gravity="center"
            android:id="@+id/v_btn_gps"
            android:background="@drawable/bg_btn1"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="方法四：关闭同步时间/地区，GPS获取时间后修改(需root/公签)"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_btn_http"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
