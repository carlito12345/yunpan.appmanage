<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:background="#90000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:paddingBottom="@dimen/dp_18"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_18"
        android:paddingEnd="@dimen/dp_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/v_ts1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="创建压缩文件"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:layout_marginBottom="@dimen/dp_6">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="文件名称："/>
            <EditText
                android:textSize="@dimen/sp_12"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/v_edit"
                android:background="@drawable/selector_input"
                android:focusable="true"
                android:layout_width="@dimen/dp_200"
                android:layout_height="@dimen/dp_30"
                android:hint="压缩包名称，无需后缀"
                android:maxLines="1"
                android:minLines="1"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/color_cursor"
                android:layout_marginStart="@dimen/dp_6"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_marginBottom="@dimen/dp_2">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="压缩格式："/>
            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:orientation="horizontal"
                android:id="@+id/v_review_gs"
                android:tag="tvHotListForLine"
                android:paddingTop="@dimen/dp_3"
                android:paddingBottom="@dimen/dp_3"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="@dimen/dp_15"
                app:tv_horizontalSpacingWithMargins="@dimen/dp_8"
                app:tv_layoutManager="V7LinearLayoutManager"
                app:tv_selectedItemIsCentered="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/v_ll_passWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置密码："/>
            <EditText
                android:textSize="@dimen/sp_12"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/v_password"
                android:background="@drawable/selector_input"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_30"
                android:hint="不设置请留空"
                android:maxLines="1"
                android:minLines="1"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/color_cursor"
                android:layout_marginStart="@dimen/dp_6"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/v_btn_yes"
                android:background="@drawable/bg_btn1"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_20">
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textColor="@color/button"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:focusable="false"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="确定"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/v_btn_no"
                android:background="@drawable/bg_btn1"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_6">
                <TextView
                    android:textSize="@dimen/sp_15"
                    android:textColor="@color/btn_text_color1"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:focusable="false"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="取消"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
