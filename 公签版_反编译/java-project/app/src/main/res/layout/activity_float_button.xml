<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/dp_10">
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:orientation="horizontal"
        android:id="@+id/v_list_gn"
        android:focusable="true"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_select_open"
        android:background="@drawable/bg_btn2"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/v_list_gn"
        app:layout_constraintStart_toEndOf="@+id/v_list_gn"
        app:layout_constraintTop_toTopOf="@+id/v_list_gn">
        <ImageView
            android:id="@+id/v_select_open_ico"
            android:duplicateParentState="true"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:src="@drawable/tp_check1"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开启悬浮按钮"
            android:layout_marginStart="@dimen/dp_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/v_select_open_ico"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/v_ico"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/float_icon_transparent_1"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_list_gn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_select_open"
        app:layout_constraintTop_toTopOf="@+id/v_list_gn"/>
    <View
        android:id="@+id/v_view1"
        android:background="@color/color_2"
        android:padding="@dimen/dp_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_list_gn"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:orientation="vertical"
        android:id="@+id/v_list_key"
        android:focusable="true"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/dp_128"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_view1"/>
    <View
        android:id="@+id/v_view2"
        android:background="@color/color_2"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_list_key"
        app:layout_constraintTop_toBottomOf="@+id/v_view1"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/v_list_map"
        android:focusable="true"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/v_ts1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_view2"
        app:layout_constraintTop_toBottomOf="@+id/v_view1"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_2"
        android:gravity="center"
        android:id="@+id/v_ts1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="如果有双击的话，那么单击就要等待400毫秒判断没有双击后才会触发单击\10所以一般不建议你设置双击的映射，这样单击才好用\10按住0.2秒后可拖拽，快速从按钮位置点并滑动可触发上下左右滑"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/v_list_map"
        app:layout_constraintStart_toStartOf="@+id/v_list_map"/>
</androidx.constraintlayout.widget.ConstraintLayout>
