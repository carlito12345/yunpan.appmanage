<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/wu_focus"
    android:padding="@dimen/dp_1"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/v_file_image"
        android:background="@drawable/focus_app_list_piliang"
        android:padding="@dimen/dp_5"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_110"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/v_file_ico"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_25"
        android:layout_marginBottom="@dimen/dp_25"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_file_image"
        app:layout_constraintEnd_toEndOf="@+id/v_file_image"
        app:layout_constraintStart_toStartOf="@+id/v_file_image"
        app:layout_constraintTop_toTopOf="@+id/v_file_image"/>
    <ImageView
        android:id="@+id/v_file_ico_xiao"
        android:layout_width="@dimen/dp_26"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_5"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_file_image"
        app:layout_constraintEnd_toEndOf="@+id/v_file_image"
        app:layout_constraintStart_toStartOf="@+id/v_file_image"
        app:layout_constraintTop_toTopOf="@+id/v_file_image"/>
    <ImageView
        android:id="@+id/v_select"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:layout_margin="@dimen/dp_10"
        android:src="@drawable/check1"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="@+id/v_file_image"
        app:layout_constraintTop_toTopOf="@+id/v_file_image"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="#99ff6600"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/v_file_attribute"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_1"
        android:text="文件属性"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_file_image"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="@color/click"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/v_file_name"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="电视剧_v33.333.333.apk"
        android:maxLines="3"
        android:minLines="1"
        android:lineSpacingExtra="-4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_file_attribute"/>
</androidx.constraintlayout.widget.ConstraintLayout>
