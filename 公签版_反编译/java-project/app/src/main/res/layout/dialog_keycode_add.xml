<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_15"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="#ffffff"
            android:id="@+id/v_ts1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="备注："
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_edit_name"/>
        <EditText
            android:textSize="@dimen/sp_18"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/v_edit_name"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="@dimen/dp_200"
            android:layout_height="@dimen/dp_36"
            android:hint="名称"
            android:maxLines="1"
            android:minLines="1"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintStart_toEndOf="@+id/v_ts1"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/button"
            android:id="@+id/v_btn_select_name"
            android:background="@drawable/shape_btn_focus"
            android:paddingTop="@dimen/dp_6"
            android:paddingBottom="@dimen/dp_6"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="常用"
            android:paddingStart="@dimen/dp_15"
            android:paddingEnd="@dimen/dp_15"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_name"
            app:layout_constraintStart_toEndOf="@+id/v_edit_name"
            app:layout_constraintTop_toTopOf="@+id/v_edit_name"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/v_ts2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="键码："
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_keycode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_edit_keycode"/>
        <EditText
            android:textSize="@dimen/sp_18"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/v_edit_keycode"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:layout_marginTop="@dimen/dp_10"
            android:hint="(必填)"
            android:maxLines="1"
            android:minLines="1"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintEnd_toEndOf="@+id/v_edit_name"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/v_edit_name"
            app:layout_constraintTop_toBottomOf="@+id/v_edit_name"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/button"
            android:id="@+id/v_btn_select_keycode"
            android:background="@drawable/shape_btn_focus"
            android:paddingTop="@dimen/dp_6"
            android:paddingBottom="@dimen/dp_6"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="监听"
            android:paddingStart="@dimen/dp_15"
            android:paddingEnd="@dimen/dp_15"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_keycode"
            app:layout_constraintStart_toEndOf="@+id/v_edit_keycode"
            app:layout_constraintTop_toTopOf="@+id/v_edit_keycode"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/button"
            android:gravity="center"
            android:id="@+id/v_btn_yes"
            android:background="@drawable/shape_btn_focus"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_12"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="确定"
            app:layout_constraintEnd_toEndOf="@+id/v_edit_keycode"
            app:layout_constraintStart_toStartOf="@+id/v_edit_keycode"
            app:layout_constraintTop_toBottomOf="@+id/v_edit_keycode"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
