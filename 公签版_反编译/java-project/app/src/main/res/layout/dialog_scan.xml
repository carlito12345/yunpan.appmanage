<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:background="#90000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_18"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/color_2"
            android:id="@+id/v_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全盘扫描"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_4"
            android:gravity="center"
            android:id="@+id/v_content"
            android:layout_width="@dimen/dp_660"
            android:layout_height="wrap_content"
            android:text="文件管理采用的是缓存模式，打开管家后自动全盘扫描并缓存！这样就可以快速读取目录、快速搜索！ 但有个弊端：使用管家过程中切换到其它应用进行下载文件到本地 或者 本地文件变动了，那么切换回到管家就需要刷新目录，或者直接重新全盘扫描一次！这种情况极少，所以一般用不着全盘扫描！"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_title"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_content">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_btn_yes"
                android:background="@drawable/shape_btn_focus"
                android:paddingTop="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_16"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全盘扫描"
                android:paddingStart="@dimen/dp_20"
                android:paddingEnd="@dimen/dp_20"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_btn_no"
                android:background="@drawable/shape_btn_focus"
                android:paddingTop="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_16"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消扫描"
                android:paddingStart="@dimen/dp_20"
                android:paddingEnd="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_20"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
