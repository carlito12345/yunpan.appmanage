<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <EditText
        android:textSize="@dimen/sp_16"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/v_edit_cmd"
        android:background="@drawable/selector_input"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30"
        android:layout_margin="@dimen/dp_10"
        android:text="df"
        android:hint="在这里输入命令"
        android:maxLines="1"
        android:minLines="1"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@drawable/color_cursor"
        android:paddingStart="@dimen/dp_6"
        android:paddingEnd="@dimen/dp_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:orientation="horizontal"
        android:id="@+id/v_list_btn"
        android:padding="@dimen/dp_6"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_edit_cmd"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_4"
        app:tv_layoutManager="V7LinearLayoutManager"
        app:tv_selectedItemIsCentered="true"
        app:tv_verticalSpacingWithMargins="@dimen/dp_4"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarSize="3dp"
        android:scrollbarThumbVertical="@drawable/custom_scrollbar_thumb"
        android:scrollbarTrackVertical="@drawable/custom_scrollbar_track"
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/v_scrollView"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fadeScrollbars="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_list_btn">
        <HorizontalScrollView
            android:scrollbarSize="3dp"
            android:scrollbarThumbHorizontal="@drawable/custom_scrollbar_thumb"
            android:scrollbarTrackHorizontal="@drawable/custom_scrollbar_track"
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/v_hScrollView"
            android:scrollbars="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="false">
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="#cccc00"
                android:ellipsize="none"
                android:id="@+id/v_output"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/dp_6"
                android:text=""
                android:singleLine="false"
                android:textIsSelectable="true"/>
        </HorizontalScrollView>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/v_qrCode"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_list_btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
