<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:scrollbarThumbVertical="@drawable/scrollbar1"
            android:scrollbarStyle="outsideOverlay"
            android:background="@drawable/shape_noback_nofocus"
            android:focusable="false"
            android:scrollbars="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fadeScrollbars="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center"
                android:padding="@dimen/dp_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="#ffffff"
                    android:id="@+id/v_ts1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按键备注："
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_name"/>
                <EditText
                    android:textSize="@dimen/sp_18"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:id="@+id/v_edit_name"
                    android:background="@drawable/selector_input"
                    android:focusable="true"
                    android:layout_width="@dimen/dp_500"
                    android:layout_height="@dimen/dp_36"
                    android:hint="按键名称(备注名)"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintStart_toEndOf="@+id/v_ts1"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/v_ts2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="主键日志：\10(按下)"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_down"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_down"/>
                <EditText
                    android:textSize="@dimen/sp_10"
                    android:textColor="#000000"
                    android:id="@+id/v_edit_down"
                    android:background="@drawable/selector_input"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_80"
                    android:layout_marginTop="4dp"
                    android:hint="(必填)"
                    android:inputType="textMultiLine"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_edit_name"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="@+id/v_edit_name"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_name"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/button"
                    android:id="@+id/v_btn_select_down"
                    android:background="@drawable/shape_btn_focus"
                    android:paddingTop="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_8"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择"
                    android:paddingStart="@dimen/dp_15"
                    android:paddingEnd="@dimen/dp_15"
                    android:layout_marginStart="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_down"
                    app:layout_constraintStart_toEndOf="@+id/v_edit_down"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_down"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/v_ts3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="主键日志：\10(松开)"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_up"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_up"/>
                <EditText
                    android:textSize="@dimen/sp_10"
                    android:textColor="#000000"
                    android:id="@+id/v_edit_up"
                    android:background="@drawable/selector_input"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_70"
                    android:layout_marginTop="@dimen/dp_10"
                    android:hint="(不懂的话请留空，不需要长按就不用设置)"
                    android:inputType="textMultiLine"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_edit_name"
                    app:layout_constraintStart_toStartOf="@+id/v_edit_name"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_down"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/button"
                    android:id="@+id/v_btn_select_up"
                    android:background="@drawable/shape_btn_focus"
                    android:paddingTop="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_8"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择"
                    android:paddingStart="@dimen/dp_15"
                    android:paddingEnd="@dimen/dp_15"
                    android:layout_marginStart="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_up"
                    app:layout_constraintStart_toEndOf="@+id/v_edit_up"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_up"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/v_ts4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="触发日志：\10(组合键)"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_zh"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_zh"/>
                <EditText
                    android:textSize="@dimen/sp_10"
                    android:textColor="#000000"
                    android:id="@+id/v_edit_zh"
                    android:background="@drawable/selector_input"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_70"
                    android:layout_marginTop="@dimen/dp_10"
                    android:hint="(不需要的话请留空)"
                    android:inputType="textMultiLine"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_edit_name"
                    app:layout_constraintStart_toStartOf="@+id/v_edit_name"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_up"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/button"
                    android:id="@+id/v_btn_select_zh"
                    android:background="@drawable/shape_btn_focus"
                    android:paddingTop="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_8"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择"
                    android:paddingStart="@dimen/dp_15"
                    android:paddingEnd="@dimen/dp_15"
                    android:layout_marginStart="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_zh"
                    app:layout_constraintStart_toEndOf="@+id/v_edit_zh"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_zh"/>
                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/v_list_check"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_zh"
                    app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
                    app:tv_verticalSpacingWithMargins="@dimen/dp_6"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/v_lay_gn"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_list_check">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+单击操作"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click_double"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+双击操作"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"
                        android:layout_marginStart="@dimen/dp_10"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click_long"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+长按操作"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"
                        android:layout_marginStart="@dimen/dp_10"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click_zh"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+组合操作"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"
                        android:layout_marginStart="@dimen/dp_10"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click_save"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="保存"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"
                        android:layout_marginStart="@dimen/dp_10"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click_delete"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="删除"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"
                        android:layout_marginStart="@dimen/dp_10"/>
                </LinearLayout>
                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:scrollbarThumbVertical="@drawable/scrollbar1"
                    android:id="@+id/v_list"
                    android:background="@drawable/shape_list_bk"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:scrollbars="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_110"
                    android:layout_marginTop="@dimen/dp_10"
                    android:scrollbarFadeDuration="0"
                    android:scrollbarDefaultDelayBeforeFade="0"
                    android:fadeScrollbars="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_lay_gn"
                    app:tv_horizontalSpacingWithMargins="@dimen/dp_6"
                    app:tv_verticalSpacingWithMargins="@dimen/dp_6"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
