<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_20"
        android:focusable="false"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_50"
        android:layout_marginEnd="@dimen/dp_50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <EditText
            android:textSize="@dimen/sp_20"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/v_edit_x"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="@dimen/dp_260"
            android:layout_height="@dimen/dp_40"
            android:hint=""
            android:maxLines="1"
            android:minLines="1"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="坐标x："
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_x"
            app:layout_constraintEnd_toStartOf="@+id/v_edit_x"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_edit_x"/>
        <EditText
            android:textSize="@dimen/sp_20"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/v_edit_y"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_10"
            android:hint=""
            android:maxLines="1"
            android:minLines="1"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintEnd_toEndOf="@+id/v_edit_x"
            app:layout_constraintStart_toStartOf="@+id/v_edit_x"
            app:layout_constraintTop_toBottomOf="@+id/v_edit_x"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="坐标y："
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_y"
            app:layout_constraintEnd_toStartOf="@+id/v_edit_y"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_edit_y"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/button"
            android:id="@+id/v_btn"
            android:background="@drawable/shape_btn_focus"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="确定"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_edit_y"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/v_btn"
            app:layout_constraintEnd_toStartOf="@+id/v_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_btn">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/v_api"
                android:background="@drawable/bg_installer"
                android:padding="@dimen/dp_6"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/dp_100"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_14">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/btn_text_color1"
                    android:id="@+id/v_api_name"
                    android:duplicateParentState="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="方法一"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:src="@drawable/tp_down10"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="@dimen/dp_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/v_type"
                android:background="@drawable/bg_installer"
                android:padding="@dimen/dp_6"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/dp_100"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_20">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/btn_text_color1"
                    android:id="@+id/v_type_name"
                    android:duplicateParentState="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="单击"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:src="@drawable/tp_down10"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="@dimen/dp_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
