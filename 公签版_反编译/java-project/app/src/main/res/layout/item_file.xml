<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/shape_user_focus"
    android:padding="@dimen/dp_3"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_50">
    <ImageView
        android:id="@+id/v_file_image"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/v_file_ico"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/v_file_ico_xiao"
        android:layout_width="@dimen/dp_12"
        android:layout_height="@dimen/dp_12"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/v_file_ico"
        app:layout_constraintStart_toStartOf="@+id/v_file_ico"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="#00fffc"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/v_file_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="电视剧_v33.333.333.apk"
        android:maxLines="2"
        android:minLines="1"
        android:lineSpacingExtra="-4dp"
        app:layout_constraintBottom_toTopOf="@+id/v_file_attribute"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_file_ico"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="#fff000"
        android:id="@+id/v_file_attribute"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="2023.10.10 23:23    20 M"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_file_ico"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/button"
        android:gravity="center"
        android:id="@+id/v_item_state"
        android:background="@drawable/background_item_btn_white"
        android:duplicateParentState="true"
        android:layout_width="@dimen/dp_50"
        android:layout_height="@dimen/dp_30"
        android:text="安装"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/v_select"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:src="@drawable/check1"
        android:scaleType="fitCenter"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/v_item_state"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
