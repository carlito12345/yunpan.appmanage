<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:background="#90000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_12"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/v_scroll"
            android:background="@drawable/shape_no_focus"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/v_list_check"
                    android:padding="@dimen/dp_5"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
                    app:tv_layoutManager="V7LinearLayoutManager"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/dp_10"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center"
                    android:id="@+id/v_btn_is_not_scanning_usb"
                    android:background="@drawable/shape_setting_model_focus"
                    android:paddingTop="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_8"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:paddingStart="@dimen/dp_14"
                    android:paddingEnd="@dimen/dp_14"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_marginEnd="@dimen/dp_6"
                    app:layout_constraintEnd_toEndOf="@+id/v_list_check"
                    app:layout_constraintStart_toStartOf="@+id/v_list_check"
                    app:layout_constraintTop_toBottomOf="@+id/v_list_check">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/v_btn_is_not_scanning_usb_ico"
                        android:focusable="false"
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_26"
                        android:layout_height="@dimen/dp_26"
                        android:src="@drawable/check1"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/sp_13"
                        android:textColor="@color/button"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="不扫描文件总大小超过100G的U盘（建议勾选）"
                        android:layout_marginStart="@dimen/dp_3"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/v_btn_is_not_scanning_usb_ico"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/v_lay1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_btn_is_not_scanning_usb">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ffffff"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="图标/图片缩略图："
                        app:layout_constraintBottom_toBottomOf="@+id/v_spinner_installer"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/v_thumbnail_1"
                        android:background="@drawable/bg_btn4"
                        android:padding="@dimen/dp_4"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/v_thumbnail_1_ico"
                            android:layout_width="@dimen/dp_22"
                            android:layout_height="@dimen/dp_22"
                            android:src="@drawable/tp_radio_no1"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/btn_text_color1"
                            android:duplicateParentState="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="低质(省内存)"
                            android:paddingEnd="@dimen/dp_2"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/v_thumbnail_2"
                        android:background="@drawable/bg_btn4"
                        android:padding="@dimen/dp_4"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8">
                        <ImageView
                            android:id="@+id/v_thumbnail_2_ico"
                            android:layout_width="@dimen/dp_22"
                            android:layout_height="@dimen/dp_22"
                            android:src="@drawable/tp_radio_no1"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/btn_text_color1"
                            android:duplicateParentState="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="中等"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/v_thumbnail_3"
                        android:background="@drawable/bg_btn4"
                        android:padding="@dimen/dp_4"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8">
                        <ImageView
                            android:id="@+id/v_thumbnail_3_ico"
                            android:layout_width="@dimen/dp_22"
                            android:layout_height="@dimen/dp_22"
                            android:src="@drawable/tp_radio_no1"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"/>
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/btn_text_color1"
                            android:duplicateParentState="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="高清"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_2"
                    android:id="@+id/v_type_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="文件类型识别"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_lay1"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/v_text_apk"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:text="安装包:"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_list_check"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_apk"/>
                <EditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/edittextcolor"
                    android:gravity="center"
                    android:id="@+id/v_edit_apk"
                    android:background="@drawable/selector_input2"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_35"
                    android:layout_marginTop="@dimen/dp_8"
                    android:hint="输入类型(如:apk|apk.1|apkx)"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_list_check"
                    app:layout_constraintStart_toEndOf="@+id/v_text_apk"
                    app:layout_constraintTop_toBottomOf="@+id/v_type_text"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/v_text_zip"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="压缩包:"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_zip"
                    app:layout_constraintEnd_toEndOf="@+id/v_text_apk"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_zip"/>
                <EditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/edittextcolor"
                    android:gravity="center"
                    android:id="@+id/v_edit_zip"
                    android:background="@drawable/selector_input2"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_35"
                    android:layout_marginTop="@dimen/dp_8"
                    android:hint="输入类型(如:zip|rar|7z)"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_edit_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_edit_apk"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_apk"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:gravity="end|center_vertical"
                    android:id="@+id/v_text_image"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="图片:"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_image"
                    app:layout_constraintEnd_toEndOf="@+id/v_text_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_text_apk"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_image"/>
                <EditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/edittextcolor"
                    android:gravity="center"
                    android:id="@+id/v_edit_image"
                    android:background="@drawable/selector_input2"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_35"
                    android:layout_marginTop="@dimen/dp_8"
                    android:hint="输入类型(如:png|jpg|jepg)"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_edit_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_edit_apk"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_zip"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:gravity="end|center_vertical"
                    android:id="@+id/v_text_video"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="视频:"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_video"
                    app:layout_constraintEnd_toEndOf="@+id/v_text_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_text_apk"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_video"/>
                <EditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/edittextcolor"
                    android:gravity="center"
                    android:id="@+id/v_edit_video"
                    android:background="@drawable/selector_input2"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_35"
                    android:layout_marginTop="@dimen/dp_8"
                    android:hint="输入类型(如:mp4|mkv|avi|flv|wmv)"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_edit_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_edit_apk"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_image"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:gravity="end|center_vertical"
                    android:id="@+id/v_text_music"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="音乐:"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_music"
                    app:layout_constraintEnd_toEndOf="@+id/v_text_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_text_apk"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_music"/>
                <EditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/edittextcolor"
                    android:gravity="center"
                    android:id="@+id/v_edit_music"
                    android:background="@drawable/selector_input2"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_35"
                    android:layout_marginTop="@dimen/dp_8"
                    android:hint="输入类型(如:mp3|wav|ogg|flac)"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_edit_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_edit_apk"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_video"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:gravity="end|center_vertical"
                    android:id="@+id/v_text_txt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="文本:"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_txt"
                    app:layout_constraintEnd_toEndOf="@+id/v_text_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_text_apk"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_txt"/>
                <EditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/edittextcolor"
                    android:gravity="center"
                    android:id="@+id/v_edit_txt"
                    android:background="@drawable/selector_input2"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_35"
                    android:layout_marginTop="@dimen/dp_8"
                    android:hint="输入类型(如:txt|pdf|ppt|pptx|xml|html)"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_edit_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_edit_apk"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_music"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:gravity="end|center_vertical"
                    android:id="@+id/v_text_wp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="网盘包:"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_wp"
                    app:layout_constraintEnd_toEndOf="@+id/v_text_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_text_apk"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_wp"/>
                <EditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/edittextcolor"
                    android:gravity="center"
                    android:id="@+id/v_edit_wp"
                    android:background="@drawable/selector_input2"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_35"
                    android:layout_marginTop="@dimen/dp_8"
                    android:hint="输入类型"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_edit_apk"
                    app:layout_constraintStart_toStartOf="@+id/v_edit_apk"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_txt"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
