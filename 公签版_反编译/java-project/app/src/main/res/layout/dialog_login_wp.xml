<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:background="#90000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_16"
        android:focusable="false"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_text_user"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="账号："
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_user"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_edit_user"/>
        <EditText
            android:textSize="@dimen/sp_14"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/v_edit_user"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:hint="请输入账号/手机号"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/v_text_user"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_text_password"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="密码："
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_edit_password"/>
        <EditText
            android:textSize="@dimen/sp_14"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/v_edit_password"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_13"
            android:hint="请输入密码"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/v_text_password"
            app:layout_constraintTop_toBottomOf="@+id/v_edit_user"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/button"
            android:id="@+id/v_btn_login"
            android:background="@drawable/background_item_btn"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_13"
            android:text="登录"
            android:paddingStart="@dimen/dp_28"
            android:paddingEnd="@dimen/dp_28"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_edit_password"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_6"
            android:id="@+id/v_text_ts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="123云盘：下载大于100M的文件需要登录"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_btn_login"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
