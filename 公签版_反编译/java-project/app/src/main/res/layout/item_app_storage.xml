<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/shape_user_focus"
    android:padding="@dimen/dp_8"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/v_ico"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:src="@drawable/apk"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="#00fffc"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:id="@+id/v_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="电视剧_v33.333.333.apk"
        android:singleLine="true"
        android:layout_weight="3"
        android:layout_marginStart="@dimen/dp_10"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_6"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/v_size_code"
        android:layout_width="@dimen/dp_120"
        android:layout_height="wrap_content"
        android:text="18 M"
        android:singleLine="true"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_17"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/v_size_cache"
        android:layout_width="@dimen/dp_120"
        android:layout_height="wrap_content"
        android:text="18 M"
        android:singleLine="true"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_FFB800"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/v_size_data"
        android:layout_width="@dimen/dp_120"
        android:layout_height="wrap_content"
        android:text="18 M"
        android:singleLine="true"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_9"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/v_size"
        android:layout_width="@dimen/dp_120"
        android:layout_height="wrap_content"
        android:text="18 M"
        android:singleLine="true"/>
</LinearLayout>
