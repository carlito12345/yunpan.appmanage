<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:background="#00000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_root2"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:scrollbarThumbVertical="@drawable/scrollbar1"
            android:scrollbarStyle="outsideOverlay"
            android:background="@drawable/shape_dialog_first"
            android:focusable="false"
            android:scrollbars="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fadeScrollbars="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_14"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_14"
                android:paddingEnd="@dimen/dp_14"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="#ffffff"
                    android:id="@+id/v_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="喊麦设置"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:id="@+id/v_ts1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选麦克风："
                    app:layout_constraintBottom_toBottomOf="@+id/v_microphone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_microphone"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_microphone"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:layout_weight="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/v_ts1"
                    app:layout_constraintTop_toBottomOf="@+id/v_title">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_microphone_name"
                        android:duplicateParentState="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="默认"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="声音增益："
                    app:layout_constraintBottom_toBottomOf="@+id/v_seek_micro"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_seek_micro"/>
                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/v_seek_micro"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/v_ts2"
                    app:layout_constraintTop_toBottomOf="@+id/v_microphone"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:id="@+id/v_ts6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="降噪方案："
                    app:layout_constraintBottom_toBottomOf="@+id/v_zhk_noise"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_zhk_noise"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_zhk_noise"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_weight="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/v_ts6"
                    app:layout_constraintTop_toBottomOf="@+id/v_seek_micro">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_zhk_noise_name"
                        android:duplicateParentState="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="方案一：系统降噪+软降噪"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:id="@+id/v_ts2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="抢占焦点："
                    app:layout_constraintBottom_toBottomOf="@+id/v_zhk_focus"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_zhk_focus"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_zhk_focus"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_weight="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/v_ts2"
                    app:layout_constraintTop_toBottomOf="@+id/v_zhk_noise">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_zhk_focus_name"
                        android:duplicateParentState="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="无"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:id="@+id/v_ts9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音响选择："
                    app:layout_constraintBottom_toBottomOf="@+id/v_speaker"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_speaker"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_speaker"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:layout_weight="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/v_ts9"
                    app:layout_constraintTop_toBottomOf="@+id/v_zhk_focus">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_speaker_name"
                        android:duplicateParentState="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="系统默认"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="修改音量："
                    app:layout_constraintBottom_toBottomOf="@+id/v_type_vol"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_type_vol"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_type_vol"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/v_ts2"
                    app:layout_constraintTop_toBottomOf="@+id/v_speaker">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_type_vol_name"
                        android:duplicateParentState="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="播放时修改系统音量(媒体音量)"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统音量："
                    app:layout_constraintBottom_toBottomOf="@+id/v_seek_vol"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_seek_vol"/>
                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/v_seek_vol"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/v_ts2"
                    app:layout_constraintTop_toBottomOf="@+id/v_type_vol"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/v_lay_b"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_seek_vol">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="播放通道："/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/v_type_td"
                        android:background="@drawable/bg_installer"
                        android:padding="@dimen/dp_6"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/sp_16"
                            android:textColor="@color/btn_text_color1"
                            android:id="@+id/v_type_td_name"
                            android:duplicateParentState="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="通道0"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:duplicateParentState="true"
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_20"
                            android:src="@drawable/tp_down10"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:layout_marginStart="@dimen/dp_8"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/v_type_td_name"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_btn_yes"
                        android:background="@drawable/bg_btn1"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="确定添加"
                        android:paddingStart="@dimen/dp_18"
                        android:paddingEnd="@dimen/dp_18"
                        android:layout_marginStart="@dimen/dp_10"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_btn_bf"
                        android:background="@drawable/bg_btn1"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="测试喊麦"
                        android:paddingStart="@dimen/dp_18"
                        android:paddingEnd="@dimen/dp_18"
                        android:layout_marginStart="@dimen/dp_10"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/btn_text_color1"
                    android:id="@+id/v_btn_test2"
                    android:background="@drawable/bg_btn1"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="逐一测试喇叭(请仔细聆听，自行甄别)"
                    android:paddingStart="@dimen/dp_18"
                    android:paddingEnd="@dimen/dp_18"
                    android:layout_marginStart="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_lay_b"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:text="以上一些设置不一定对您系统有效，请自行测试各种设置的可用性\10如果有车外喇叭的话，可在音响里选择，某些车在通道里选择\10如果出现爆音破音等情况，请降低增益，或者尝试不同的方案\10\10如果出现无声破音爆音回声等情况，则不适合您车机使用，未适配\10吉利Flyme系列的车机连接的外部喇叭一般是(通道73)"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_btn_test2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
