<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:background="#00000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_14"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:scrollbarThumbVertical="@drawable/scrollbar1"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/v_scroll"
            android:background="@drawable/shape_noback_nofocus"
            android:scrollbars="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_10"
            android:fadeScrollbars="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:background="@drawable/shape_noback_nofocus"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="#ffffff"
                    android:id="@+id/v_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="指定时间段"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_start_h"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_title">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_start_h_name"
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="wrap_content"
                        android:text="18"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_8"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/v_start_h_name"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_start_m"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/dp_4"
                    app:layout_constraintBottom_toBottomOf="@+id/v_start_h"
                    app:layout_constraintStart_toEndOf="@+id/v_start_h"
                    app:layout_constraintTop_toTopOf="@+id/v_start_h">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_start_m_name"
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="wrap_content"
                        android:text="12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_8"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/v_start_m_name"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/btn_text_color1"
                    android:gravity="center"
                    android:id="@+id/v1"
                    android:duplicateParentState="true"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="0dp"
                    android:text="至"
                    app:layout_constraintBottom_toBottomOf="@+id/v_start_h"
                    app:layout_constraintStart_toEndOf="@+id/v_start_m"
                    app:layout_constraintTop_toTopOf="@+id/v_start_h"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_end_h"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/dp_4"
                    app:layout_constraintBottom_toBottomOf="@+id/v_start_h"
                    app:layout_constraintStart_toEndOf="@+id/v1"
                    app:layout_constraintTop_toTopOf="@+id/v_start_h">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_end_h_name"
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="wrap_content"
                        android:text="6"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_8"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/v_end_h_name"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_end_m"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/dp_4"
                    app:layout_constraintBottom_toBottomOf="@+id/v_start_h"
                    app:layout_constraintStart_toEndOf="@+id/v_end_h"
                    app:layout_constraintTop_toTopOf="@+id/v_start_h">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_end_m_name"
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="wrap_content"
                        android:text="12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_8"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/v_end_m_name"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/btn_text_color1"
                    android:id="@+id/v_btn_yes"
                    android:background="@drawable/bg_btn1"
                    android:paddingTop="@dimen/dp_12"
                    android:paddingBottom="@dimen/dp_12"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="确定添加"
                    android:paddingStart="@dimen/dp_18"
                    android:paddingEnd="@dimen/dp_18"
                    android:layout_marginStart="@dimen/dp_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_start_h"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
