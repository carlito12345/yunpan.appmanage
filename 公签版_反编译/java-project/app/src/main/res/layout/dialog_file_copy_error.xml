<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:background="#90000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_4"
        android:focusable="false"
        android:layout_width="@dimen/dp_600"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/v_ico"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/wxts"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="#ffff00"
            android:id="@+id/v_title"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="以下文件拷贝失败："
            app:layout_constraintBottom_toBottomOf="@+id/v_ico"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_11"
            android:textColor="@color/button"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/v_btn_yes"
            android:background="@drawable/shape_btn_focus"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/dp_70"
            android:layout_height="@dimen/dp_26"
            android:text="知道了"
            app:layout_constraintBottom_toBottomOf="@+id/v_ico"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:scrollbarThumbVertical="@drawable/scrollbar1"
            android:orientation="vertical"
            android:id="@+id/v_list"
            android:background="#00000000"
            android:paddingTop="@dimen/dp_12"
            android:focusable="true"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_ico"
            app:tv_horizontalSpacingWithMargins="@dimen/dp_7"
            app:tv_layoutManager="V7LinearLayoutManager"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/dp_7"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
