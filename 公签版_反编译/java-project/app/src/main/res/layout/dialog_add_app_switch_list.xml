<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:background="#00000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_root2"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:scrollbarThumbVertical="@drawable/scrollbar1"
            android:scrollbarStyle="outsideOverlay"
            android:background="@drawable/shape_dialog_first"
            android:focusable="false"
            android:scrollbars="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fadeScrollbars="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_14"
                android:focusable="false"
                android:layout_width="@dimen/dp_500"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_14"
                android:paddingEnd="@dimen/dp_14"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="#ffffff"
                    android:id="@+id/v_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="指定应用循环切换"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:scrollbarThumbVertical="@drawable/scrollbar1"
                    android:id="@+id/v_list"
                    android:background="#00000000"
                    android:padding="@dimen/dp_10"
                    android:focusable="true"
                    android:scrollbars="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_160"
                    android:layout_margin="@dimen/dp_4"
                    android:scrollbarFadeDuration="0"
                    android:scrollbarDefaultDelayBeforeFade="0"
                    android:fadeScrollbars="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_title"
                    app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/dp_5"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/v_lay_b"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_list">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_btn_add"
                        android:background="@drawable/bg_btn1"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="添加应用"
                        android:paddingStart="@dimen/dp_18"
                        android:paddingEnd="@dimen/dp_18"
                        android:layout_marginStart="@dimen/dp_10"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_btn_yes"
                        android:background="@drawable/bg_btn1"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="确定映射"
                        android:paddingStart="@dimen/dp_18"
                        android:paddingEnd="@dimen/dp_18"
                        android:layout_marginStart="@dimen/dp_10"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
