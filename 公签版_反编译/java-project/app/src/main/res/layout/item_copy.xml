<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:orientation="horizontal"
    android:padding="@dimen/dp_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_13"
        android:ellipsize="end"
        android:id="@+id/v_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="/ddfgdfgf/滴答滴答滴答滴答滴答滴答的对对对对对对的点点滴滴.apk"
        app:layout_constraintEnd_toStartOf="@+id/v_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="#99ffffff"
        android:ellipsize="end"
        android:id="@+id/v_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="原大小:32423543    新大小:232435345"
        android:singleLine="true"
        app:layout_constraintEnd_toStartOf="@+id/v_cover"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_name"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/click"
        android:id="@+id/v_cover"
        android:background="@drawable/shape_btn_focus"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="覆盖"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/v_skip"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/click"
        android:id="@+id/v_skip"
        android:background="@drawable/shape_btn_focus"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跳过"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
