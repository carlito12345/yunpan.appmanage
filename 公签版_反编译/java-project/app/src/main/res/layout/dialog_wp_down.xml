<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_15"
        android:focusable="false"
        android:layout_width="@dimen/dp_550"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="#ffff00"
            android:id="@+id/v_file_name"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电视家V1.1.1.1.1"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="#ffb000"
            android:id="@+id/v_file_size"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="大小：28.43M  时间：昨天17:02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_file_name"/>
        <com.yunpan.appmanage.view.MyProgressViewTest
            android:id="@+id/v_progress"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_22"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_file_size"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="#ff0000"
            android:layout_gravity="center"
            android:id="@+id/v_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3463645/3465467547"
            app:layout_constraintBottom_toBottomOf="@+id/v_progress"
            app:layout_constraintEnd_toEndOf="@+id/v_progress"
            app:layout_constraintStart_toStartOf="@+id/v_progress"
            app:layout_constraintTop_toTopOf="@+id/v_progress"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/btn_text_color1"
            android:id="@+id/v_btn_down"
            android:background="@drawable/shape_btn_focus"
            android:paddingTop="@dimen/dp_14"
            android:paddingBottom="@dimen/dp_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="取消下载"
            android:paddingStart="@dimen/dp_25"
            android:paddingEnd="@dimen/dp_25"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_progress"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
