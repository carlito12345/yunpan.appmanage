<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_user_focus"
    android:padding="@dimen/dp_2"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_52"
    android:layout_margin="@dimen/dp_12">
    <ImageView
        android:id="@+id/v_ico"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        android:src="@drawable/apk"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="#00fffc"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/v_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="电视剧_v33.333.333.apk"
        android:maxLines="2"
        android:minLines="1"
        android:lineSpacingExtra="-4dp"
        app:layout_constraintBottom_toTopOf="@+id/v_time"
        app:layout_constraintEnd_toStartOf="@+id/v_down"
        app:layout_constraintStart_toEndOf="@+id/v_ico"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_11"
        android:textColor="#fff000"
        android:gravity="center_vertical"
        android:id="@+id/v_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="2023.10.10 23:23    20 M"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/v_down"
        app:layout_constraintStart_toEndOf="@+id/v_ico"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/button"
        android:gravity="center"
        android:id="@+id/v_down"
        android:background="@drawable/background_item_btn_white"
        android:duplicateParentState="true"
        android:layout_width="@dimen/dp_60"
        android:layout_height="@dimen/dp_36"
        android:text="下载"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
