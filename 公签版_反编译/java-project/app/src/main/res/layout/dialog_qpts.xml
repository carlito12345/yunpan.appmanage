<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_root2"
        android:background="@drawable/background_dialog_rootlay_nostroke"
        android:paddingBottom="@dimen/dp_15"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dp_15"
        android:paddingEnd="@dimen/dp_15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_26"
            android:textColor="@color/color_10"
            android:gravity="center"
            android:id="@+id/v_title"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:maxWidth="@dimen/dp_550"
            android:text="严重警告"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/v_view1"
            android:background="#aaaaaa"
            android:focusable="false"
            android:layout_width="@dimen/dp_233"
            android:layout_height="@dimen/dp_2"
            android:layout_margin="@dimen/dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_title"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/v_btn_check"
            android:background="@drawable/bg_btn4"
            android:padding="@dimen/dp_3"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_5"
            app:layout_constraintBottom_toTopOf="@+id/v_view2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/v_btn_check_ico"
                android:focusable="false"
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_22"
                android:src="@drawable/tp_check1"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/click"
                android:id="@+id/v_btn_check_name"
                android:duplicateParentState="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我已了解，绝不随意禁用、卸载、删除系统里的任何应用和文件！并已做好防护措施！解除所有功能限制，乱操作出现的任何后果由我个人承担！"
                android:layout_marginStart="@dimen/dp_3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/v_btn_check_ico"
                app:layout_constraintTop_toTopOf="parent"/>
        </LinearLayout>
        <View
            android:id="@+id/v_view2"
            android:background="#aaaaaa"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_2"
            android:layout_margin="@dimen/dp_8"
            app:layout_constraintBottom_toTopOf="@+id/v_btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/btn_text_color1"
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/v_btn"
            android:background="@drawable/bg_btn1"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我知道了"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.core.widget.NestedScrollView
            android:scrollbarSize="4dp"
            android:scrollbarThumbVertical="@drawable/custom_scrollbar_thumb"
            android:scrollbarTrackVertical="@drawable/custom_scrollbar_track"
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/v_scrollView"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fadeScrollbars="false"
            app:layout_constraintBottom_toTopOf="@+id/v_btn_check"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_view1">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_4"
                android:id="@+id/v_content"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_3"
                android:text="提示11111111111111111111"/>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
