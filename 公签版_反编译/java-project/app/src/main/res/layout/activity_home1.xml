<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:orientation="horizontal"
        android:id="@+id/v_menu"
        android:paddingLeft="@dimen/dp_15"
        android:paddingRight="@dimen/dp_15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
        app:tv_layoutManager="com.owen.tvrecyclerview.widget.V7LinearLayoutManager"/>
    <LinearLayout
        android:padding="@dimen/dp_6"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_menu"
        app:layout_constraintEnd_toStartOf="@+id/v_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_menu">
        <ImageView
            android:id="@+id/v_btn_home"
            android:background="@drawable/btn_home_focus"
            android:padding="@dimen/dp_6"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/tp_zy1"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>
        <ImageView
            android:id="@+id/v_btn_close"
            android:background="@drawable/btn_home_focus"
            android:padding="@dimen/dp_6"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/tp_close1"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp_5"/>
        <ImageView
            android:id="@+id/v_btn_set"
            android:background="@drawable/btn_home_focus"
            android:padding="@dimen/dp_6"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/shezhi3"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp_5"/>
        <ImageView
            android:id="@+id/v_btn_screen_dp"
            android:background="@drawable/btn_home_focus"
            android:padding="@dimen/dp_6"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/tp_sf3"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp_5"/>
    </LinearLayout>
    <com.yunpan.appmanage.view.NoScrollViewPager
        android:id="@+id/v_Pager"
        android:focusable="false"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_menu"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="#99baba10"
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/v_version"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_marginEnd="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="@+id/v_menu"
        app:layout_constraintEnd_toStartOf="@+id/v_adb_text"
        app:layout_constraintTop_toTopOf="@+id/v_menu"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_6"
        android:gravity="end|center_vertical"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/v_adb_text"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_marginEnd="@dimen/dp_50"
        app:layout_constraintBottom_toBottomOf="@+id/v_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_menu"/>
</androidx.constraintlayout.widget.ConstraintLayout>
