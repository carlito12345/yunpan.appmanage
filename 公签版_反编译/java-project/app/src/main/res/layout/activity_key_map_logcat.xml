<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/dp_10">
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:orientation="horizontal"
        android:id="@+id/v_list_gn"
        android:focusable="true"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_22"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_6"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_13"
        android:id="@+id/v_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/t_title"
        app:layout_constraintBottom_toBottomOf="@+id/v_list_gn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_list_gn"
        app:layout_constraintTop_toTopOf="@+id/v_list_gn"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:scrollbarThumbVertical="@drawable/scrollbar1"
        android:id="@+id/v_list"
        android:background="#00000000"
        android:padding="@dimen/dp_16"
        android:focusable="true"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_list_gn"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_18"
        app:tv_verticalSpacingWithMargins="@dimen/dp_18"/>
</androidx.constraintlayout.widget.ConstraintLayout>
