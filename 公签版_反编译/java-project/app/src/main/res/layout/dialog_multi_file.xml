<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:background="#90000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_14"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_2"
            android:id="@+id/v_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="标题栏"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:scrollbarThumbVertical="@drawable/scrollbar1"
            android:orientation="vertical"
            android:id="@+id/v_list"
            android:background="#00000000"
            android:padding="@dimen/dp_18"
            android:focusable="true"
            android:scrollbars="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="@dimen/dp_670"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_title"
            app:tv_horizontalSpacingWithMargins="@dimen/dp_14"
            app:tv_layoutManager="V7LinearLayoutManager"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/dp_14"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:gravity="center"
            android:id="@+id/v_btn"
            android:background="@drawable/shape_btn_focus"
            android:paddingLeft="@dimen/dp_22"
            android:paddingTop="@dimen/dp_12"
            android:paddingRight="@dimen/dp_22"
            android:paddingBottom="@dimen/dp_12"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_14"
            android:text="知道了"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_list"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/v_loading"
            android:focusable="false"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/anim_loading"
            android:indeterminateBehavior="repeat"
            android:layout_marginEnd="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="@+id/v_btn"
            app:layout_constraintEnd_toStartOf="@+id/v_btn"
            app:layout_constraintTop_toTopOf="@+id/v_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
