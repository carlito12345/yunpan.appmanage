<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/v_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:orientation="horizontal"
        android:id="@+id/v_list_path"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_4"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_52"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="@+id/v_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tv_horizontalSpacingWithMargins="0dp"
        app:tv_layoutManager="V7LinearLayoutManager"
        app:tv_selectedItemIsCentered="true"
        app:tv_verticalSpacingWithMargins="0dp"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:scrollbarThumbVertical="@drawable/scrollbar1"
        android:id="@+id/v_list_file"
        android:background="#00000000"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_20"
        android:focusable="true"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/dp_20"
        android:paddingEnd="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/v_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_list_path"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
        app:tv_selectedItemIsCentered="true"
        app:tv_verticalSpacingWithMargins="@dimen/dp_10"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_lay_load_more"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/v_guideline"
        app:layout_constraintStart_toStartOf="parent">
        <ProgressBar
            android:id="@+id/v_lay_load_more_a"
            android:focusable="false"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/anim_loading"
            android:indeterminateBehavior="repeat"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/v_lay_load_more_b"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_2"
            android:id="@+id/v_lay_load_more_b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加载更多中"
            android:paddingStart="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <EditText
        android:textSize="@dimen/sp_13"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/v_url"
        android:background="@drawable/selector_input"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_20"
        android:hint="输入文件的分享地址(地址#密码)"
        android:maxLines="1"
        android:singleLine="true"
        android:selectAllOnFocus="true"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@drawable/color_cursor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:orientation="horizontal"
        android:id="@+id/v_list_gn"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/v_guideline"
        app:layout_constraintTop_toBottomOf="@+id/v_url"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_6"
        app:tv_layoutManager="V7LinearLayoutManager"
        app:tv_selectedItemIsCentered="true"
        app:tv_verticalSpacingWithMargins="@dimen/dp_6"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:scrollbarThumbVertical="@drawable/scrollbar1"
        android:id="@+id/v_list_down"
        android:background="#00000000"
        android:paddingTop="@dimen/dp_5"
        android:paddingBottom="@dimen/dp_5"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/v_guideline"
        app:layout_constraintTop_toBottomOf="@+id/v_list_gn"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
        app:tv_selectedItemIsCentered="true"
        app:tv_verticalSpacingWithMargins="@dimen/dp_6"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_lay_qrcode"
        android:background="@drawable/dialog_default"
        android:focusable="false"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/v_url"
        app:layout_constraintStart_toStartOf="@+id/v_url"
        app:layout_constraintTop_toBottomOf="@+id/v_list_gn">
        <ImageView
            android:id="@+id/v_image_qrCode"
            android:padding="@dimen/dp_20"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toTopOf="@+id/v_qrcode_ip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_9"
            android:id="@+id/v_qrcode_ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_6"
            android:text="浏览器：192.168.3.111:9898/url.html"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_lay_history"
        android:background="@drawable/dialog_default"
        android:focusable="false"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/v_url"
        app:layout_constraintStart_toStartOf="@+id/v_url"
        app:layout_constraintTop_toBottomOf="@+id/v_list_gn">
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:scrollbarThumbVertical="@drawable/scrollbar1"
            android:id="@+id/v_list_history"
            android:background="#00000000"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_6"
            android:scrollbars="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:layout_constraintBottom_toTopOf="@+id/v_history_ts"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/dp_10"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_9"
            android:gravity="center"
            android:id="@+id/v_history_ts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_6"
            android:text="长按可删除，http前面可添加备注"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_13"
        android:id="@+id/v_help"
        android:background="@drawable/dialog_default"
        android:padding="@dimen/dp_20"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="只支持：光鸭云盘、蓝奏云、小飞机网盘、雀云网盘、拾光坞、Alist(部分)\10填写格式：分享地址#密码(分享地址和密码用#隔开)\10分享地址http前面可以添加备注\10\10文件默认下载到(Download)目录内\10\10个别网盘需要登录一个账号才能下载文件\10\10提示：链接中少于两个文件的不保存到历史记录中\10删除某个历史记录：长按链接即可删除"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/v_url"
        app:layout_constraintStart_toStartOf="@+id/v_url"
        app:layout_constraintTop_toBottomOf="@+id/v_list_gn"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/v_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_list_file">
        <ProgressBar
            android:focusable="false"
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_100"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/anim_loading"
            android:indeterminateBehavior="repeat"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加载中"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
