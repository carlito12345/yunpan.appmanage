<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:background="#00000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_gravity="center"
        android:background="#00000000"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:id="@+id/v_root2"
            android:background="@drawable/shape_dialog_first"
            android:padding="@dimen/dp_16"
            android:focusable="false"
            android:layout_width="@dimen/dp_470"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_2"
                android:id="@+id/v_title"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WebDAV"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="#ffffff"
                android:id="@+id/v_text_ip"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主机："
                app:layout_constraintBottom_toBottomOf="@+id/v_edit_ip"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/v_edit_ip"/>
            <EditText
                android:textSize="@dimen/sp_16"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/v_edit_ip"
                android:background="@drawable/selector_input"
                android:focusable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_8"
                android:hint="http://dav.baidu.com:443/dav"
                android:maxLines="1"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/color_cursor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/v_text_ip"
                app:layout_constraintTop_toBottomOf="@+id/v_title"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="#ffffff"
                android:id="@+id/v_text_user"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户："
                app:layout_constraintBottom_toBottomOf="@+id/v_edit_user"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/v_edit_user"/>
            <EditText
                android:textSize="@dimen/sp_16"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/v_edit_user"
                android:background="@drawable/selector_input"
                android:focusable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_8"
                android:hint="用户名(留空为匿名)"
                android:maxLines="1"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/color_cursor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/v_text_user"
                app:layout_constraintTop_toBottomOf="@+id/v_edit_ip"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="#ffffff"
                android:id="@+id/v_text_password"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="密码："
                app:layout_constraintBottom_toBottomOf="@+id/v_edit_password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/v_edit_password"/>
            <EditText
                android:textSize="@dimen/sp_16"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/v_edit_password"
                android:background="@drawable/selector_input"
                android:focusable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_8"
                android:hint="请输入密码"
                android:maxLines="1"
                android:singleLine="true"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/color_cursor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/v_text_password"
                app:layout_constraintTop_toBottomOf="@+id/v_edit_user"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/button"
                android:id="@+id/v_btn_login"
                android:background="@drawable/shape_btn_focus"
                android:paddingTop="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_12"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_13"
                android:text="确定"
                android:paddingStart="@dimen/dp_30"
                android:paddingEnd="@dimen/dp_30"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v_edit_password"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
