<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:padding="@dimen/dp_10"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_28"
        android:textColor="@color/color_13"
        android:id="@+id/v_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="个性自定义"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:background="@drawable/shape_noback_nofocus"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/v_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.3"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/v_guideline_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.7"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="标准图标："
                app:layout_constraintBottom_toBottomOf="@+id/v_icon"
                app:layout_constraintEnd_toStartOf="@+id/v_guideline"
                app:layout_constraintTop_toTopOf="@+id/v_icon"/>
            <ImageView
                android:id="@+id/v_icon"
                android:focusable="false"
                android:layout_width="@dimen/dp_120"
                android:layout_height="@dimen/dp_70"
                android:src="@drawable/gj_ico"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_btn_select1"
                android:background="@drawable/bg_btn1"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择"
                app:layout_constraintBottom_toBottomOf="@+id/v_icon"
                app:layout_constraintStart_toEndOf="@+id/v_guideline_end"
                app:layout_constraintTop_toTopOf="@+id/v_icon"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_btn_recovery1"
                android:background="@drawable/bg_btn1"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="复原"
                android:layout_marginStart="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="@+id/v_icon"
                app:layout_constraintStart_toEndOf="@+id/v_btn_select1"
                app:layout_constraintTop_toTopOf="@+id/v_icon"/>
            <TextView
                android:textSize="@dimen/sp_20"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="横幅图标："
                app:layout_constraintBottom_toBottomOf="@+id/v_banner"
                app:layout_constraintEnd_toStartOf="@+id/v_guideline"
                app:layout_constraintTop_toTopOf="@+id/v_banner"/>
            <ImageView
                android:id="@+id/v_banner"
                android:focusable="false"
                android:layout_width="@dimen/dp_120"
                android:layout_height="@dimen/dp_70"
                android:layout_marginTop="@dimen/dp_10"
                android:src="@drawable/gj_banner"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v_icon"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_btn_select2"
                android:background="@drawable/bg_btn1"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择"
                app:layout_constraintBottom_toBottomOf="@+id/v_banner"
                app:layout_constraintStart_toEndOf="@+id/v_guideline_end"
                app:layout_constraintTop_toTopOf="@+id/v_banner"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_btn_recovery2"
                android:background="@drawable/bg_btn1"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="复原"
                android:layout_marginStart="@dimen/dp_6"
                app:layout_constraintBottom_toBottomOf="@+id/v_banner"
                app:layout_constraintStart_toEndOf="@+id/v_btn_select2"
                app:layout_constraintTop_toTopOf="@+id/v_banner"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/v_lay_key"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_10"
                app:layout_constraintTop_toBottomOf="@+id/v_banner">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/v_line_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.3"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/v_line_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.7"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="签名文件："
                    app:layout_constraintBottom_toBottomOf="@+id/v_btn_select3"
                    app:layout_constraintEnd_toStartOf="@+id/v_line_start"
                    app:layout_constraintTop_toTopOf="@+id/v_btn_select3"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_2"
                    android:id="@+id/v_key_file"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="请选择您的签名文件(.jks)"
                    app:layout_constraintBottom_toBottomOf="@+id/v_btn_select3"
                    app:layout_constraintEnd_toStartOf="@+id/v_line_end"
                    app:layout_constraintStart_toEndOf="@+id/v_line_start"
                    app:layout_constraintTop_toTopOf="@+id/v_btn_select3"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/btn_text_color1"
                    android:id="@+id/v_btn_select3"
                    android:background="@drawable/bg_btn1"
                    android:paddingLeft="@dimen/dp_16"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingRight="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_10"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择"
                    app:layout_constraintStart_toEndOf="@+id/v_line_end"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="签名密码："
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_password"
                    app:layout_constraintEnd_toStartOf="@+id/v_line_start"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_password"/>
                <EditText
                    android:textSize="@dimen/sp_12"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:id="@+id/v_edit_password"
                    android:background="@drawable/selector_input"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_36"
                    android:layout_marginTop="@dimen/dp_10"
                    android:hint="请输入此签名密码"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toStartOf="@+id/v_line_end"
                    app:layout_constraintStart_toEndOf="@+id/v_line_start"
                    app:layout_constraintTop_toBottomOf="@+id/v_btn_select3"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="签名别名："
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_alias"
                    app:layout_constraintEnd_toStartOf="@+id/v_line_start"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_alias"/>
                <EditText
                    android:textSize="@dimen/sp_12"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:id="@+id/v_edit_alias"
                    android:background="@drawable/selector_input"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_36"
                    android:layout_marginTop="@dimen/dp_10"
                    android:hint="请输入此签名别名"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toStartOf="@+id/v_line_end"
                    app:layout_constraintStart_toEndOf="@+id/v_line_start"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_password"/>
                <TextView
                    android:textSize="@dimen/sp_20"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="别名密码："
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_alias_password"
                    app:layout_constraintEnd_toStartOf="@+id/v_line_start"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_alias_password"/>
                <EditText
                    android:textSize="@dimen/sp_12"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:id="@+id/v_edit_alias_password"
                    android:background="@drawable/selector_input"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_36"
                    android:layout_marginTop="@dimen/dp_10"
                    android:hint="请输入此签名别名密码"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toStartOf="@+id/v_line_end"
                    app:layout_constraintStart_toEndOf="@+id/v_line_start"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_alias"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_btn_ok"
                android:background="@drawable/bg_btn1"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="确定更改"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v_lay_key"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_btn_return"
                android:background="@drawable/bg_btn1"
                android:paddingLeft="@dimen/dp_16"
                android:paddingTop="@dimen/dp_10"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消"
                app:layout_constraintBottom_toBottomOf="@+id/v_btn_ok"
                app:layout_constraintStart_toEndOf="@+id/v_guideline_end"
                app:layout_constraintTop_toTopOf="@+id/v_btn_ok"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
