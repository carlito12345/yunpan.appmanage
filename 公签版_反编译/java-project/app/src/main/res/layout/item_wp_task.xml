<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_user_focus"
    android:padding="@dimen/dp_4"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/v_file_ico"
        android:duplicateParentState="true"
        android:layout_width="@dimen/dp_30"
        android:layout_height="@dimen/dp_30"
        android:src="@drawable/tp_apk2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="#00fffc"
        android:ellipsize="end"
        android:id="@+id/v_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="三个电饭锅电饭锅发光飞碟.txt"
        android:maxLines="1"
        android:lineSpacingExtra="-4dp"
        android:layout_marginStart="@dimen/dp_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_file_ico"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_16"
        android:ellipsize="end"
        android:id="@+id/v_text_toDir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="上传到：蓝奏云，大小：10 MB "
        android:maxLines="1"
        android:lineSpacingExtra="-4dp"
        android:layout_marginStart="@dimen/dp_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_file_ico"
        app:layout_constraintTop_toBottomOf="@+id/v_file_name"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_13"
        android:ellipsize="end"
        android:id="@+id/v_text_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="上传中：50% 3463645/3465467547"
        android:maxLines="1"
        android:lineSpacingExtra="-4dp"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/v_text_toDir"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_text_toDir"
        app:layout_constraintTop_toTopOf="@+id/v_text_toDir"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/btn_text_color1"
        android:id="@+id/v_btn_state"
        android:background="@drawable/shape_btn_focus"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="取消"
        android:paddingStart="@dimen/dp_20"
        android:paddingEnd="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
