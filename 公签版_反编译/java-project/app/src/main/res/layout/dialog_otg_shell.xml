<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:background="@drawable/background_dialog_rootlay_nostroke"
    android:padding="@dimen/dp_16"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/btn_text_color1"
        android:id="@+id/v_btn_return"
        android:background="@drawable/bg_btn1"
        android:paddingLeft="@dimen/dp_14"
        android:paddingTop="@dimen/dp_8"
        android:paddingRight="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_8"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="返回"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/btn_text_color1"
        android:id="@+id/v_btn_delete"
        android:background="@drawable/bg_btn1"
        android:paddingLeft="@dimen/dp_14"
        android:paddingTop="@dimen/dp_8"
        android:paddingRight="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_8"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="清空"
        android:layout_marginEnd="@dimen/dp_6"
        app:layout_constraintEnd_toStartOf="@+id/v_btn_return"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/btn_text_color1"
        android:id="@+id/v_btn_yes"
        android:background="@drawable/bg_btn1"
        android:paddingLeft="@dimen/dp_14"
        android:paddingTop="@dimen/dp_8"
        android:paddingRight="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_8"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:text="执行"
        app:layout_constraintStart_toStartOf="@+id/v_btn_delete"
        app:layout_constraintTop_toBottomOf="@+id/v_btn_return"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/btn_text_color1"
        android:id="@+id/v_btn_past"
        android:background="@drawable/bg_btn1"
        android:paddingLeft="@dimen/dp_14"
        android:paddingTop="@dimen/dp_8"
        android:paddingRight="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_8"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="粘贴"
        app:layout_constraintEnd_toEndOf="@+id/v_btn_return"
        app:layout_constraintStart_toStartOf="@+id/v_btn_return"
        app:layout_constraintTop_toTopOf="@+id/v_btn_yes"/>
    <EditText
        android:textSize="@dimen/sp_14"
        android:id="@+id/v_cmd"
        android:background="@drawable/selector_input"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="请输入命令"
        android:inputType="textMultiLine"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@drawable/color_cursor"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/v_btn_yes"
        app:layout_constraintEnd_toStartOf="@+id/v_btn_delete"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_btn_return"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="#ffffff"
        android:id="@+id/v_ts"
        android:padding="@dimen/dp_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="下面是执行命令结果"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_btn_yes"/>
    <EditText
        android:textSize="@dimen/sp_14"
        android:textColor="#ffffff"
        android:gravity="start|top"
        android:id="@+id/v_out"
        android:background="@drawable/bg_edittext_trans"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:inputType="textMultiLine"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@drawable/color_cursor"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_ts"/>
</androidx.constraintlayout.widget.ConstraintLayout>
