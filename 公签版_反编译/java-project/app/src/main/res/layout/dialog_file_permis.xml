<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:background="#90000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_6"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="修改权限"/>
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="所有者："/>
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_all_r"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="读"
                android:layout_marginStart="@dimen/dp_5"/>
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_all_w"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="写"
                android:layout_marginStart="@dimen/dp_5"/>
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_all_x"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="执行"
                android:layout_marginStart="@dimen/dp_5"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2">
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户组："/>
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_user_r"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="读"
                android:layout_marginStart="@dimen/dp_5"/>
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_user_w"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="写"
                android:layout_marginStart="@dimen/dp_5"/>
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_user_x"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="执行"
                android:layout_marginStart="@dimen/dp_5"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2">
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="其它组："/>
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_other_r"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="读"
                android:layout_marginStart="@dimen/dp_5"/>
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_other_w"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="写"
                android:layout_marginStart="@dimen/dp_5"/>
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_other_x"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="执行"
                android:layout_marginStart="@dimen/dp_5"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_ts_uid"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="设置UID"/>
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_ts_gid"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="设置GID"/>
            <CheckBox
                android:textSize="@dimen/sp_13"
                android:textColor="@color/btn_text_color1"
                android:layout_gravity="center"
                android:id="@+id/v_ts_zz"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/color_check1"
                android:text="粘滞"/>
        </LinearLayout>
        <CheckBox
            android:textSize="@dimen/sp_13"
            android:textColor="@color/btn_text_color1"
            android:layout_gravity="center"
            android:id="@+id/v_all"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:button="@drawable/color_check1"
            android:text="包括所有子文件子目录"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_17"
            android:id="@+id/v_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="rwxrwxrwx(777)"/>
        <View
            android:background="@color/color_6A6A6A_95"
            android:layout_width="@dimen/dp_260"
            android:layout_height="@dimen/dp_1"
            android:layout_margin="@dimen/dp_6"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_10">
            <EditText
                android:textSize="@dimen/sp_10"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/v_edit"
                android:background="@drawable/selector_input"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_30"
                android:hint="请输入"
                android:maxLines="1"
                android:minLines="1"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/color_cursor"
                android:layout_marginEnd="@dimen/dp_20"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/v_btn_yes"
                android:background="@drawable/bg_btn1"
                android:paddingTop="@dimen/dp_3"
                android:paddingBottom="@dimen/dp_3"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_20"
                android:paddingEnd="@dimen/dp_20">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/btn_text_color1"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:focusable="false"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_30"
                    android:text="确认"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/v_btn_no"
                android:background="@drawable/bg_btn1"
                android:paddingTop="@dimen/dp_3"
                android:paddingBottom="@dimen/dp_3"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_20"
                android:paddingEnd="@dimen/dp_20"
                android:layout_marginStart="@dimen/dp_10">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/btn_text_color1"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:focusable="false"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_30"
                    android:text="取消"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
