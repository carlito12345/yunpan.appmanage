<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_16"
        android:focusable="false"
        android:layout_width="@dimen/dp_570"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/color_13"
            android:id="@+id/v_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在复制"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/color_2"
            android:id="@+id/v_bfb"
            android:padding="@dimen/dp_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00%"
            app:layout_constraintBottom_toBottomOf="@+id/v_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_title"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_str1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:text="来自："
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_title"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_str2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:text="目的："
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_str1"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_str_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="5.89 MB / 257 MB"
            app:layout_constraintEnd_toStartOf="@+id/v_str_speed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_str2"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_str_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5.89 MB/s"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_str_size"/>
        <com.yunpan.appmanage.view.MyProgressViewTest
            android:id="@+id/v_progress"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_13"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_str_size"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_str_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="进度：1/100"
            app:layout_constraintEnd_toStartOf="@+id/v_str_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_progress"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_str_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_str_progress"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/btn_text_color1"
            android:id="@+id/v_btn_cancel"
            android:background="@drawable/shape_btn_focus"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="取消"
            android:paddingStart="@dimen/dp_22"
            android:paddingEnd="@dimen/dp_22"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_str_progress"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
