<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_15"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:background="@drawable/shape_noback_nofocus"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="#ffffff"
                    android:id="@+id/v_ts1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="备注名："
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_name"/>
                <EditText
                    android:textSize="@dimen/sp_18"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:id="@+id/v_edit_name"
                    android:background="@drawable/selector_input"
                    android:focusable="true"
                    android:layout_width="@dimen/dp_500"
                    android:layout_height="@dimen/dp_36"
                    android:hint="按键名称(备注名)"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintStart_toEndOf="@+id/v_ts1"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center"
                    android:id="@+id/v_select_open"
                    android:background="@drawable/bg_btn2"
                    android:paddingLeft="@dimen/dp_10"
                    android:paddingRight="@dimen/dp_10"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/v_edit_name"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_name">
                    <ImageView
                        android:id="@+id/v_select_open_ico"
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_check1"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/btn_text_color1"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开启"
                        android:layout_marginStart="@dimen/dp_2"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/v_select_open_ico"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/v_ts2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="主键码："
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_zj"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_zj"/>
                <EditText
                    android:textSize="@dimen/sp_18"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:id="@+id/v_edit_zj"
                    android:background="@drawable/selector_input"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_36"
                    android:layout_marginTop="4dp"
                    android:hint="(必填)"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_edit_name"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="@+id/v_edit_name"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_name"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/button"
                    android:id="@+id/v_btn_select_zj"
                    android:background="@drawable/shape_btn_focus"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择"
                    android:paddingStart="@dimen/dp_15"
                    android:paddingEnd="@dimen/dp_15"
                    android:layout_marginStart="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_zj"
                    app:layout_constraintStart_toEndOf="@+id/v_edit_zj"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_zj"/>
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/v_ts3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="组合键："
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_zhj"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_zhj"/>
                <EditText
                    android:textSize="@dimen/sp_16"
                    android:textColor="#000000"
                    android:gravity="center"
                    android:id="@+id/v_edit_zhj"
                    android:background="@drawable/selector_input"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_36"
                    android:layout_marginTop="@dimen/dp_10"
                    android:hint="(不需要组合键就不用设置)"
                    android:maxLines="1"
                    android:minLines="1"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintEnd_toEndOf="@+id/v_edit_name"
                    app:layout_constraintStart_toStartOf="@+id/v_edit_name"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_zj"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/button"
                    android:id="@+id/v_btn_select_zhj"
                    android:background="@drawable/shape_btn_focus"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择"
                    android:paddingStart="@dimen/dp_15"
                    android:paddingEnd="@dimen/dp_15"
                    android:layout_marginStart="@dimen/dp_6"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit_zhj"
                    app:layout_constraintStart_toEndOf="@+id/v_edit_zhj"
                    app:layout_constraintTop_toTopOf="@+id/v_edit_zhj"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/v_lay_gn"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit_zhj">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+单击操作"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click_double"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+双击操作"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"
                        android:layout_marginStart="@dimen/dp_10"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click_long"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+长按操作"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"
                        android:layout_marginStart="@dimen/dp_10"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click_zh"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+组合操作"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"
                        android:layout_marginStart="@dimen/dp_10"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click_save"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="保存"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"
                        android:layout_marginStart="@dimen/dp_10"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/button"
                        android:id="@+id/v_btn_click_delete"
                        android:background="@drawable/shape_btn_focus"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingBottom="@dimen/dp_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="删除"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16"
                        android:layout_marginStart="@dimen/dp_10"/>
                </LinearLayout>
                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:scrollbarThumbVertical="@drawable/scrollbar1"
                    android:id="@+id/v_list"
                    android:background="@drawable/shape_list_bk"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:scrollbars="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_160"
                    android:layout_marginTop="@dimen/dp_10"
                    android:scrollbarFadeDuration="0"
                    android:scrollbarDefaultDelayBeforeFade="0"
                    android:fadeScrollbars="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_lay_gn"
                    app:tv_horizontalSpacingWithMargins="@dimen/dp_6"
                    app:tv_verticalSpacingWithMargins="@dimen/dp_6"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
