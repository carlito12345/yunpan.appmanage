<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:paddingLeft="@dimen/dp_30"
    android:paddingRight="@dimen/dp_30"
    android:paddingBottom="@dimen/dp_30"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/v_btn_return"
        android:background="@drawable/shape_btn_focus"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_5"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:src="@drawable/return1"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/button"
            android:gravity="center"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/v_btn_set"
        android:background="@drawable/shape_btn_focus"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingStart="@dimen/dp_10"
        android:paddingEnd="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/v_btn_return"
        app:layout_constraintStart_toEndOf="@+id/v_btn_return"
        app:layout_constraintTop_toTopOf="@+id/v_btn_return">
        <ImageView
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:src="@drawable/shezhi3"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/button"
            android:gravity="center"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_9"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="无障碍服务管理 （开启/关闭）"
        android:layout_weight="3"
        app:layout_constraintBottom_toBottomOf="@+id/v_btn_return"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_btn_return"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:scrollbarThumbVertical="@drawable/scrollbar1"
        android:id="@+id/v_list"
        android:background="#00000000"
        android:padding="@dimen/dp_16"
        android:focusable="true"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_btn_return"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_18"
        app:tv_verticalSpacingWithMargins="@dimen/dp_18"/>
    <TextView
        android:textSize="@dimen/sp_26"
        android:textColor="@color/color_1"
        android:gravity="center"
        android:id="@+id/v_ts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="获取中"
        android:layout_weight="3"
        app:layout_constraintBottom_toBottomOf="@+id/v_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_list"/>
</androidx.constraintlayout.widget.ConstraintLayout>
