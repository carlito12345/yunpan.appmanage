<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:paddingBottom="@dimen/dp_15"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="@dimen/dp_630"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="#e3416b"
                android:layout_gravity="center"
                android:id="@+id/v_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="开机任务设置"/>
            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:scrollbarThumbVertical="@drawable/scrollbar1"
                android:orientation="vertical"
                android:id="@+id/v_list"
                android:background="#00000000"
                android:padding="@dimen/dp_8"
                android:focusable="true"
                android:scrollbars="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_10"
                android:layout_weight="2"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_10"
                app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
                app:tv_layoutManager="V7LinearLayoutManager"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/dp_10"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/v_lay1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_20"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="如果勾选系统加载完成再执行任务，检测到加载完成后是否还继续延时："/>
                    <EditText
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/edittextcolor"
                        android:gravity="center"
                        android:id="@+id/v_et_time_load_delay"
                        android:background="@drawable/selector_input2"
                        android:focusable="true"
                        android:layout_width="@dimen/dp_50"
                        android:layout_height="@dimen/dp_30"
                        android:text="1"
                        android:hint="（空）"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        android:textCursorDrawable="@drawable/color_cursor"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="秒再执行"
                        android:layout_marginStart="@dimen/dp_3"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="正常开机等："/>
                    <EditText
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/edittextcolor"
                        android:gravity="center"
                        android:id="@+id/v_et_time_boot"
                        android:background="@drawable/selector_input2"
                        android:focusable="true"
                        android:layout_width="@dimen/dp_50"
                        android:layout_height="@dimen/dp_30"
                        android:text="40"
                        android:hint="（空）"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        android:textCursorDrawable="@drawable/color_cursor"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="秒再执行任务，如果是睡眠车机直接唤醒的话则不延时，直接执行"
                        android:layout_marginStart="@dimen/dp_3"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/v_lay2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="屏幕熄灭后："/>
                    <EditText
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/edittextcolor"
                        android:gravity="center"
                        android:id="@+id/v_et_time"
                        android:background="@drawable/selector_input2"
                        android:focusable="true"
                        android:layout_width="@dimen/dp_50"
                        android:layout_height="@dimen/dp_30"
                        android:text="0"
                        android:hint="（空）"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        android:textCursorDrawable="@drawable/color_cursor"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="分钟内重新点亮屏幕的话，禁止触发开机任务(仅对部分休眠车机有效)"
                        android:layout_marginStart="@dimen/dp_3"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="如果勾选上面的屏幕点亮触发机制，可在这里根据自身需要设置！比如：车机熄火几分钟时间又重新上车的，那时候车机里的第三方应用还没有被系统消灭时，你可能不需要再次执行开机任务，可以在这里设置时间"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
