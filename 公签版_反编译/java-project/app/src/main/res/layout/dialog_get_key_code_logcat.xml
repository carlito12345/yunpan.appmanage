<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_10"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginEnd="@dimen/dp_40">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/v_lay_gn"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_3"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/button"
                android:id="@+id/v_btn_start"
                android:background="@drawable/shape_btn_focus"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="监听日志"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/button"
                android:id="@+id/v_btn_close"
                android:background="@drawable/shape_btn_focus"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关闭"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_6"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/button"
                android:id="@+id/v_btn_save"
                android:background="@drawable/shape_btn_focus"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="导出"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_6"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/button"
                android:id="@+id/v_btn_xfc"
                android:background="@drawable/shape_btn_focus"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="悬浮"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_6"/>
            <TextView
                android:textSize="@dimen/dp_13"
                android:textColor="@color/color_13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击监听&gt;&gt;等出现日志或等一秒后，点击物理按键，然后立马点停止监听&gt;&gt;得到日志"
                android:layout_marginStart="@dimen/dp_10"/>
        </LinearLayout>
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:scrollbarThumbVertical="@drawable/scrollbar1"
            android:id="@+id/v_list"
            android:background="#00000000"
            android:padding="@dimen/dp_6"
            android:focusable="true"
            android:scrollbars="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_10"
            android:scrollbarFadeDuration="0"
            android:scrollbarDefaultDelayBeforeFade="0"
            android:fadeScrollbars="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_lay_gn"
            app:tv_horizontalSpacingWithMargins="@dimen/dp_6"
            app:tv_verticalSpacingWithMargins="@dimen/dp_6"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
