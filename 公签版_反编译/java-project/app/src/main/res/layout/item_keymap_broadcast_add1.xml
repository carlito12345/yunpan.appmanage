<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_wk1"
    android:padding="@dimen/dp_10"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_type"
        android:background="@drawable/bg_installer"
        android:padding="@dimen/dp_6"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/dp_150"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/btn_text_color1"
            android:id="@+id/v_type_name"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="getStringExtra"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:duplicateParentState="true"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:src="@drawable/tp_down10"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_marginStart="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <EditText
        android:textSize="@dimen/sp_12"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/v_edit_key"
        android:background="@drawable/selector_input"
        android:focusable="true"
        android:layout_width="@dimen/dp_180"
        android:layout_height="0dp"
        android:hint="name"
        android:maxLines="1"
        android:minLines="1"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@drawable/color_cursor"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/v_type"
        app:layout_constraintStart_toEndOf="@+id/v_type"
        app:layout_constraintTop_toTopOf="@+id/v_type"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="#ffffff"
        android:textColorHint="@color/color_3"
        android:gravity="center_horizontal"
        android:id="@+id/v_ts1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="等于"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/v_type"
        app:layout_constraintStart_toEndOf="@+id/v_edit_key"
        app:layout_constraintTop_toTopOf="@+id/v_type"/>
    <EditText
        android:textSize="@dimen/sp_12"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/v_edit_value"
        android:background="@drawable/selector_input"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="value"
        android:maxLines="1"
        android:minLines="1"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:textCursorDrawable="@drawable/color_cursor"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/v_type"
        app:layout_constraintEnd_toStartOf="@+id/v_delect"
        app:layout_constraintStart_toEndOf="@+id/v_ts1"
        app:layout_constraintTop_toTopOf="@+id/v_type"/>
    <ImageView
        android:id="@+id/v_delect"
        android:background="@drawable/bg_btn2"
        android:padding="@dimen/dp_4"
        android:focusable="true"
        android:clickable="true"
        android:duplicateParentState="true"
        android:layout_width="@dimen/dp_40"
        android:layout_height="0dp"
        android:src="@drawable/tp_delete3"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_type"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_type"/>
</androidx.constraintlayout.widget.ConstraintLayout>
