<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:background="#00000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_16"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="#ffffff"
            android:id="@+id/v_ts1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="字体大小："
            app:layout_constraintBottom_toBottomOf="@+id/v_seek_size"
            app:layout_constraintEnd_toStartOf="@+id/v_seek_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_seek_size"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/v_seek_size"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/dp_400"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/v_ts1"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="#ffffff"
            android:id="@+id/v_ts2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="显示内容："
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_seek_size"/>
        <EditText
            android:textSize="@dimen/sp_14"
            android:gravity="top|left"
            android:id="@+id/v_content"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_108"
            android:hint="请输入要显示的消息"
            android:inputType="textMultiLine"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/v_ts2"
            app:layout_constraintTop_toTopOf="@+id/v_ts2"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="#ffffff"
            android:id="@+id/v_ts3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示时长："
            app:layout_constraintBottom_toBottomOf="@+id/v_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_time"/>
        <EditText
            android:textSize="@dimen/sp_14"
            android:gravity="center"
            android:id="@+id/v_time"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="@dimen/dp_68"
            android:layout_height="@dimen/dp_38"
            android:layout_marginTop="@dimen/dp_8"
            android:text="0"
            android:inputType="number"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintStart_toStartOf="@+id/v_content"
            app:layout_constraintTop_toBottomOf="@+id/v_content"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="#ffffff"
            android:id="@+id/v_ts4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 秒， 如果为 0 则自动计算显示时间"
            app:layout_constraintBottom_toBottomOf="@+id/v_time"
            app:layout_constraintStart_toEndOf="@+id/v_time"
            app:layout_constraintTop_toTopOf="@+id/v_time"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="@+id/v_content"
            app:layout_constraintStart_toStartOf="@+id/v_content"
            app:layout_constraintTop_toBottomOf="@+id/v_time">
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/button"
                android:gravity="center"
                android:id="@+id/v_btn1"
                android:background="@drawable/shape_btn_focus"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="确定"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_5"/>
            <TextView
                android:textSize="@dimen/sp_18"
                android:textColor="@color/button"
                android:gravity="center"
                android:id="@+id/v_btn2"
                android:background="@drawable/shape_btn_focus"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="测试"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_5"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
