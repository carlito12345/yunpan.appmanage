<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:background="#00000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_14"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="#ffffff"
            android:id="@+id/v_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="settings put"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_ts3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="类 型："
            app:layout_constraintBottom_toBottomOf="@+id/v_zhk1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_zhk1"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/v_zhk1"
            android:background="@drawable/bg_installer"
            android:padding="@dimen/dp_6"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/dp_130"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintStart_toEndOf="@+id/v_ts3"
            app:layout_constraintTop_toBottomOf="@+id/v_title">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_zhk1_name"
                android:duplicateParentState="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="System"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:duplicateParentState="true"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/tp_down10"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_marginStart="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/v_zhk2"
            android:background="@drawable/bg_installer"
            android:padding="@dimen/dp_6"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/dp_130"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/v_zhk1"
            app:layout_constraintTop_toTopOf="@+id/v_zhk1">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_zhk2_name"
                android:duplicateParentState="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="int"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:duplicateParentState="true"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/tp_down10"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_marginStart="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <EditText
            android:textSize="@dimen/sp_12"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/v_edit_key"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_8"
            android:hint="请输入key"
            android:maxLines="1"
            android:minLines="1"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintEnd_toEndOf="@+id/v_zhk2"
            app:layout_constraintStart_toStartOf="@+id/v_zhk1"
            app:layout_constraintTop_toBottomOf="@+id/v_zhk1"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  key："
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_key"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_edit_key"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_ts1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="如果值不是："
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_edit_value"/>
        <EditText
            android:textSize="@dimen/sp_12"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/v_edit_value"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_8"
            android:hint="请输入value"
            android:maxLines="1"
            android:minLines="1"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintEnd_toEndOf="@+id/v_edit_key"
            app:layout_constraintStart_toEndOf="@+id/v_ts1"
            app:layout_constraintTop_toBottomOf="@+id/v_edit_key"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_ts2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="那么修改为："
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_value_if"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_edit_value_if"/>
        <EditText
            android:textSize="@dimen/sp_12"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/v_edit_value_if"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_8"
            android:hint="请输入value"
            android:maxLines="1"
            android:minLines="1"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintEnd_toEndOf="@+id/v_edit_key"
            app:layout_constraintStart_toEndOf="@+id/v_ts2"
            app:layout_constraintTop_toBottomOf="@+id/v_edit_value"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_ts4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="否则修改为："
            app:layout_constraintBottom_toBottomOf="@+id/v_edit_value_else"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_edit_value_else"/>
        <EditText
            android:textSize="@dimen/sp_12"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/v_edit_value_else"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_8"
            android:hint="请输入value"
            android:maxLines="1"
            android:minLines="1"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            app:layout_constraintEnd_toEndOf="@+id/v_edit_key"
            app:layout_constraintStart_toEndOf="@+id/v_ts4"
            app:layout_constraintTop_toBottomOf="@+id/v_edit_value_if"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="警 告：危险设置，不懂勿用"
            app:layout_constraintBottom_toBottomOf="@+id/v_btn_yes"
            app:layout_constraintEnd_toStartOf="@+id/v_btn_yes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_btn_yes"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:id="@+id/v_btn_yes"
            android:background="@drawable/bg_btn1"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_12"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="确定"
            android:paddingStart="@dimen/dp_18"
            android:paddingEnd="@dimen/dp_18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_edit_value_else"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
