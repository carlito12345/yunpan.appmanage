<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:background="#00000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:padding="@dimen/dp_14"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="#ffffff"
            android:id="@+id/v_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小窗口-打开应用"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:id="@+id/v_btn_select1"
            android:background="@drawable/bg_btn1"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择"
            android:paddingStart="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_title"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_ts1"
            android:layout_width="@dimen/dp_300"
            android:layout_height="wrap_content"
            android:text="打开应用："
            app:layout_constraintBottom_toBottomOf="@+id/v_btn_select1"
            app:layout_constraintEnd_toStartOf="@+id/v_btn_select1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_btn_select1"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:id="@+id/v_btn_select2"
            android:background="@drawable/bg_btn1"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="选择"
            android:paddingStart="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_btn_select1"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:id="@+id/v_ts2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示位置："
            app:layout_constraintBottom_toBottomOf="@+id/v_btn_select2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_btn_select2"/>
        <EditText
            android:textSize="@dimen/sp_14"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/v_edit"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:hint="留空为默认"
            android:maxLines="1"
            android:minLines="1"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"
            android:layout_marginEnd="@dimen/dp_4"
            app:layout_constraintBottom_toBottomOf="@+id/v_btn_select2"
            app:layout_constraintEnd_toStartOf="@+id/v_btn_select2"
            app:layout_constraintStart_toEndOf="@+id/v_ts2"
            app:layout_constraintTop_toTopOf="@+id/v_btn_select2"/>
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="@color/btn_text_color1"
            android:id="@+id/v_btn_yes"
            android:background="@drawable/bg_btn1"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="添加映射"
            android:paddingStart="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_btn_select2"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="提示：某些应用 以及 某些系统 是不支持小窗模式打开的\10位置：左上角x,左上角y,右下角x,右下角y"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_btn_yes"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
