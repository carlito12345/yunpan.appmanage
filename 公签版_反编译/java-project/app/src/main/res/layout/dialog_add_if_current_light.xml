<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:background="#00000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_root2"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:scrollbarThumbVertical="@drawable/scrollbar1"
            android:scrollbarStyle="outsideOverlay"
            android:background="@drawable/shape_dialog_first"
            android:padding="@dimen/dp_10"
            android:focusable="false"
            android:scrollbars="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fadeScrollbars="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_14"
                android:focusable="false"
                android:layout_width="@dimen/dp_600"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_14"
                android:paddingEnd="@dimen/dp_14"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:id="@+id/v_t1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="如果当前光照亮度大于："
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_edit"/>
                <EditText
                    android:textSize="@dimen/sp_18"
                    android:textColor="@color/edittextcolor"
                    android:gravity="center"
                    android:id="@+id/v_edit"
                    android:background="@drawable/selector_input"
                    android:focusable="true"
                    android:layout_width="@dimen/dp_90"
                    android:layout_height="@dimen/dp_36"
                    android:text="100"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:maxLength="5"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:textCursorDrawable="@drawable/color_cursor"
                    app:layout_constraintStart_toEndOf="@+id/v_t1"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="实时检测："
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit"
                    app:layout_constraintEnd_toStartOf="@+id/v_add1"
                    app:layout_constraintTop_toTopOf="@+id/v_edit"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_2"
                    android:id="@+id/v_current_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    app:layout_constraintBottom_toBottomOf="@+id/v_edit"
                    app:layout_constraintEnd_toEndOf="@+id/v_add1"
                    app:layout_constraintStart_toStartOf="@+id/v_add1"
                    app:layout_constraintTop_toTopOf="@+id/v_edit"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/btn_text_color1"
                    android:id="@+id/v_add1"
                    android:background="@drawable/bg_btn1"
                    android:paddingTop="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_8"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="添加"
                    android:paddingStart="@dimen/dp_16"
                    android:paddingEnd="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_edit"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="则执行以下操作："
                    app:layout_constraintBottom_toBottomOf="@+id/v_add1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_add1"/>
                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:scrollbarThumbVertical="@drawable/scrollbar1"
                    android:id="@+id/v_list1"
                    android:background="@drawable/shape_list_bk"
                    android:focusable="true"
                    android:scrollbars="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_80"
                    android:layout_marginTop="@dimen/dp_10"
                    android:scrollbarFadeDuration="0"
                    android:scrollbarDefaultDelayBeforeFade="0"
                    android:fadeScrollbars="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_add1"
                    app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/dp_5"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/btn_text_color1"
                    android:id="@+id/v_add2"
                    android:background="@drawable/bg_btn1"
                    android:paddingTop="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_8"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="添加"
                    android:paddingStart="@dimen/dp_16"
                    android:paddingEnd="@dimen/dp_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_list1"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="否则执行以下操作："
                    app:layout_constraintBottom_toBottomOf="@+id/v_add2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_add2"/>
                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:scrollbarThumbVertical="@drawable/scrollbar1"
                    android:id="@+id/v_list2"
                    android:background="@drawable/shape_list_bk"
                    android:padding="@dimen/dp_3"
                    android:focusable="true"
                    android:scrollbars="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_80"
                    android:layout_marginTop="@dimen/dp_10"
                    android:scrollbarFadeDuration="0"
                    android:scrollbarDefaultDelayBeforeFade="0"
                    android:fadeScrollbars="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_add2"
                    app:tv_horizontalSpacingWithMargins="@dimen/dp_5"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/dp_5"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/btn_text_color1"
                    android:id="@+id/v_btn_yes"
                    android:background="@drawable/bg_btn1"
                    android:paddingTop="@dimen/dp_12"
                    android:paddingBottom="@dimen/dp_12"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="确定"
                    android:paddingStart="@dimen/dp_18"
                    android:paddingEnd="@dimen/dp_18"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_list2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
