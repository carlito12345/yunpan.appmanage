<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/v_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textSize="@dimen/sp_17"
        android:textColor="@color/color_FFB800"
        android:id="@+id/v_lift_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="运行中的应用、服务                         占用内存(pss)"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintEnd_toStartOf="@+id/v_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_view"
        android:background="#ffffff"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_2"
        android:layout_margin="@dimen/dp_3"
        app:layout_constraintEnd_toStartOf="@+id/v_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_lift_text"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:scrollbarThumbVertical="@drawable/scrollbar1"
        android:id="@+id/v_list_app"
        android:background="#00000000"
        android:padding="@dimen/dp_16"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/v_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_view"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_8"
        app:tv_selectedItemIsCentered="true"
        app:tv_verticalSpacingWithMargins="@dimen/dp_8"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_lay_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/v_list_app"
        app:layout_constraintEnd_toEndOf="@+id/v_list_app"
        app:layout_constraintStart_toStartOf="@+id/v_list_app"
        app:layout_constraintTop_toTopOf="@+id/v_list_app">
        <ProgressBar
            android:focusable="false"
            android:layout_width="@dimen/dp_90"
            android:layout_height="@dimen/dp_90"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/anim_loading"
            android:indeterminateBehavior="repeat"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_17"
            android:layout_gravity="center"
            android:background="@drawable/wu_focus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="刷新中"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_FFB800"
        android:id="@+id/v_right_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_16"
        android:text="提示：黄色名称是系统应用，青色是自装应用\10\10系统核心组件是无法结束的，结束了刷新也会出现\10\10如果不显示，请点击刷新"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_4"
        android:id="@+id/v_text_memory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="总内存：已用：剩余：\10\10虚拟内存：已用：剩余："
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_guideline"
        app:layout_constraintTop_toBottomOf="@+id/v_right_text"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/btn_text_color1"
        android:id="@+id/v_btn_refresh"
        android:background="@drawable/btn_home_focus"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:text="刷新"
        android:paddingStart="@dimen/dp_30"
        android:paddingEnd="@dimen/dp_30"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintStart_toEndOf="@+id/v_guideline"
        app:layout_constraintTop_toBottomOf="@+id/v_text_memory"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/btn_text_color1"
        android:id="@+id/v_btn_return"
        android:background="@drawable/btn_home_focus"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="返回"
        android:paddingStart="@dimen/dp_30"
        android:paddingEnd="@dimen/dp_30"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintStart_toEndOf="@+id/v_btn_refresh"
        app:layout_constraintTop_toTopOf="@+id/v_btn_refresh"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/btn_text_color1"
        android:id="@+id/v_btn_new"
        android:background="@drawable/btn_home_focus"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="新版(pss)"
        android:paddingStart="@dimen/dp_30"
        android:paddingEnd="@dimen/dp_30"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintStart_toEndOf="@+id/v_guideline"
        app:layout_constraintTop_toBottomOf="@+id/v_btn_refresh"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/btn_text_color1"
        android:gravity="center"
        android:id="@+id/v_btn_rss"
        android:background="@drawable/btn_home_focus"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="进程(rss)"
        android:paddingStart="@dimen/dp_30"
        android:paddingEnd="@dimen/dp_30"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/v_btn_new"
        app:layout_constraintStart_toEndOf="@+id/v_btn_new"
        app:layout_constraintTop_toTopOf="@+id/v_btn_new"/>
</androidx.constraintlayout.widget.ConstraintLayout>
