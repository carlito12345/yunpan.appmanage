<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:background="#00000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/v_root2"
        android:background="@drawable/background_dialog_rootlay_nostroke"
        android:padding="@dimen/dp_16"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textColor="#e3416b"
            android:id="@+id/v_title"
            android:background="@drawable/wu_focus"
            android:padding="@dimen/dp_10"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请设置管家启动密码"/>
        <TextView
            android:textSize="@dimen/sp_90"
            android:textColor="#92000f00"
            android:gravity="center"
            android:id="@+id/v_pwd"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="****"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="#e3416b"
            android:gravity="center"
            android:id="@+id/v_ts"
            android:padding="@dimen/dp_10"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="使用按键（上 下 左 右）来设置密码\10\10按OK键确定，输错了就长按OK键"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
