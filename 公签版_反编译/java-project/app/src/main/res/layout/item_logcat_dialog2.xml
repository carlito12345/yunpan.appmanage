<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_item1"
    android:padding="@dimen/dp_4"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/v_level"
        android:padding="@dimen/dp_6"
        android:layout_width="@dimen/dp_28"
        android:layout_height="0dp"
        android:text="D"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="#49454f"
        android:id="@+id/v_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="03-07 16:10:36.656  2377  2377"
        app:layout_constraintStart_toEndOf="@+id/v_level"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="#49454f"
        android:id="@+id/v_pack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="com.com.com"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_time"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_1"
        android:id="@+id/v_tag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Server"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_level"
        app:layout_constraintTop_toBottomOf="@+id/v_time"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="#49454f"
        android:id="@+id/v_msg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="sdfsgdfgdfgh"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_level"
        app:layout_constraintTop_toBottomOf="@+id/v_tag"/>
</androidx.constraintlayout.widget.ConstraintLayout>
