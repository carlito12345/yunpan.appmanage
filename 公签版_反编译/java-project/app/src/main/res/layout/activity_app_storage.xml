<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/v_btn_return"
        android:background="@drawable/bg_btn1"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:src="@drawable/return1"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:ellipsize="end"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回"
            android:maxEms="20"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/color_9"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="应用占用空间"
        app:layout_constraintBottom_toBottomOf="@+id/v_btn_return"
        app:layout_constraintEnd_toStartOf="@+id/v_btn_size_code"
        app:layout_constraintStart_toEndOf="@+id/v_btn_return"
        app:layout_constraintTop_toTopOf="@+id/v_btn_return"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/v_btn_size_code"
        android:background="@drawable/bg_btn1"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_30"
        app:layout_constraintBottom_toBottomOf="@+id/v_btn_return"
        app:layout_constraintEnd_toStartOf="@+id/v_btn_size_cache"
        app:layout_constraintTop_toTopOf="@+id/v_btn_return">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:ellipsize="end"
            android:gravity="center"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="应用"
            android:maxEms="20"
            android:singleLine="true"/>
        <ImageView
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:src="@drawable/zhankai"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/v_btn_size_cache"
        android:background="@drawable/bg_btn1"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_30"
        app:layout_constraintBottom_toBottomOf="@+id/v_btn_return"
        app:layout_constraintEnd_toStartOf="@+id/v_btn_size_data"
        app:layout_constraintTop_toTopOf="@+id/v_btn_return">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:ellipsize="end"
            android:gravity="center"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="缓存"
            android:maxEms="20"
            android:singleLine="true"/>
        <ImageView
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:src="@drawable/zhankai"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/v_btn_size_data"
        android:background="@drawable/bg_btn1"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_30"
        app:layout_constraintBottom_toBottomOf="@+id/v_btn_return"
        app:layout_constraintEnd_toStartOf="@+id/v_btn_size"
        app:layout_constraintTop_toTopOf="@+id/v_btn_return">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:ellipsize="end"
            android:gravity="center"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数据"
            android:maxEms="20"
            android:singleLine="true"/>
        <ImageView
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:src="@drawable/zhankai"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/v_btn_size"
        android:background="@drawable/bg_btn1"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_40"
        app:layout_constraintBottom_toBottomOf="@+id/v_btn_return"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_btn_return">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:ellipsize="end"
            android:gravity="center"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="总占用"
            android:maxEms="20"
            android:singleLine="true"/>
        <ImageView
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:src="@drawable/zhankai"/>
    </LinearLayout>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:scrollbarThumbVertical="@drawable/scrollbar1"
        android:id="@+id/v_list_app"
        android:background="#00000000"
        android:padding="@dimen/dp_20"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_btn_return"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
        app:tv_selectedItemIsCentered="true"
        app:tv_verticalSpacingWithMargins="@dimen/dp_10"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_btn_return">
        <ProgressBar
            android:focusable="false"
            android:layout_width="@dimen/dp_90"
            android:layout_height="@dimen/dp_90"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/anim_loading"
            android:indeterminateBehavior="repeat"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加载中"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
