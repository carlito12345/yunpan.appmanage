<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_user_focus"
    android:padding="@dimen/dp_2"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_75">
    <ImageView
        android:id="@+id/v_file_ico"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:src="@drawable/apk"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="#fff000"
        android:id="@+id/v_file_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/v_file_name"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="#00fffc"
        android:ellipsize="end"
        android:id="@+id/v_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="文件名"
        android:maxLines="2"
        android:minLines="1"
        android:lineSpacingExtra="-4dp"
        app:layout_constraintBottom_toTopOf="@+id/v_file_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_file_ico"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/button"
        android:gravity="center"
        android:id="@+id/v_item_state"
        android:background="@drawable/background_item_btn_white"
        android:duplicateParentState="true"
        android:layout_width="@dimen/dp_80"
        android:layout_height="0dp"
        android:layout_margin="@dimen/dp_8"
        android:text="下载"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
