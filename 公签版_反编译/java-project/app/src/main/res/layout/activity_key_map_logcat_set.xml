<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/dp_10">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_btn_return"
        android:background="@drawable/shape_btn_focus"
        android:paddingLeft="@dimen/dp_10"
        android:paddingTop="@dimen/dp_7"
        android:paddingRight="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_7"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/v_btn_return_ico"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/return1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/btn_text_color1"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/t_return"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/v_btn_return_ico"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_13"
        android:id="@+id/v_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="日志映射-其它设置"
        app:layout_constraintBottom_toBottomOf="@+id/v_btn_return"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_btn_return"
        app:layout_constraintTop_toTopOf="@+id/v_btn_return"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarThumbVertical="@drawable/scrollbar1"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:scrollbarStyle="outsideOverlay"
        android:background="@drawable/shape_no_focus"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_10"
        android:fadeScrollbars="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_btn_return">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_13"
                android:id="@+id/v_ts1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置等待间隔："
                app:layout_constraintBottom_toBottomOf="@+id/v_et_interval"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/v_et_interval"/>
            <EditText
                android:textSize="@dimen/sp_16"
                android:textColor="@color/edittextcolor"
                android:gravity="center"
                android:id="@+id/v_et_interval"
                android:background="@drawable/selector_input2"
                android:focusable="true"
                android:layout_width="@dimen/dp_66"
                android:layout_height="@dimen/dp_36"
                android:layout_marginTop="@dimen/dp_10"
                android:text="600"
                android:hint="600"
                android:maxLines="1"
                android:singleLine="true"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:textCursorDrawable="@drawable/color_cursor"
                app:layout_constraintStart_toEndOf="@+id/v_ts1"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_13"
                android:id="@+id/v_ts2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="毫秒  (一般600毫秒以内足够了，间隔太长的话单击就会等待越久)"
                app:layout_constraintBottom_toBottomOf="@+id/v_et_interval"
                app:layout_constraintStart_toEndOf="@+id/v_et_interval"
                app:layout_constraintTop_toTopOf="@+id/v_et_interval"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_13"
                android:id="@+id/v_ts3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="工程模式里设置的日志等级低于此等级时，自动改为："
                app:layout_constraintBottom_toBottomOf="@+id/v_level"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/v_level"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/v_level"
                android:background="@drawable/bg_installer"
                android:padding="@dimen/dp_6"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/dp_120"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                app:layout_constraintStart_toEndOf="@+id/v_ts3"
                app:layout_constraintTop_toBottomOf="@+id/v_et_interval">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/btn_text_color1"
                    android:id="@+id/v_level_name"
                    android:duplicateParentState="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="VERBOSE"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:duplicateParentState="true"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:src="@drawable/tp_down10"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="@dimen/dp_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_13"
                android:id="@+id/v_ts4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前系统："
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/v_level"
                app:layout_constraintStart_toEndOf="@+id/v_level"
                app:layout_constraintTop_toTopOf="@+id/v_level"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/color_5"
                android:id="@+id/v_current_system_log_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:layout_constraintBottom_toBottomOf="@+id/v_level"
                app:layout_constraintStart_toEndOf="@+id/v_ts4"
                app:layout_constraintTop_toTopOf="@+id/v_level"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/v_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v_level"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="#ffff00"
                android:background="@drawable/bg_null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:text="@string/activity_key_map_logcat_set"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v_list"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
