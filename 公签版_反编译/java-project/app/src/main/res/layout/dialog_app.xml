<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:paddingBottom="@dimen/dp_10"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_20"
        android:paddingEnd="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:id="@+id/v_copy_pack"
            android:background="@drawable/shape_no_focus"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10">
            <ImageView
                android:id="@+id/v_dialog_ico"
                android:focusable="false"
                android:layout_width="@dimen/dp_50"
                android:layout_height="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_2"
                android:src="@drawable/apk"
                android:layout_marginStart="@dimen/dp_2"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_10">
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="#ffff00"
                    android:id="@+id/v_dialog_name"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="电视家"/>
                <TextView
                    android:textSize="@dimen/sp_11"
                    android:textColor="#ccc666"
                    android:id="@+id/v_dialog_version"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.3.3"/>
                <TextView
                    android:textSize="@dimen/sp_11"
                    android:textColor="#0ccfff"
                    android:id="@+id/v_pack"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="com.ddsfsdg.sgsdgd"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="#ffff00"
            android:gravity="center"
            android:id="@+id/v_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="安装时间：2012.11.11"
            android:maxLines="1"/>
        <View
            android:background="#cccccc"
            android:layout_width="@dimen/dp_350"
            android:layout_height="@dimen/dp_2"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_5"/>
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/v_list"
            android:padding="@dimen/dp_15"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tv_horizontalSpacingWithMargins="@dimen/dp_12"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/dp_12"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
