<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:background="#00000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/background_dialog_rootlay_nostroke"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <EditText
            android:textSize="@dimen/sp_25"
            android:textColor="@color/edittextcolor"
            android:gravity="center"
            android:id="@+id/et_password1"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="@dimen/dp_320"
            android:layout_height="@dimen/dp_50"
            android:text=""
            android:hint="设置管家密码锁"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"/>
        <EditText
            android:textSize="@dimen/sp_25"
            android:textColor="@color/edittextcolor"
            android:gravity="center"
            android:id="@+id/et_password2"
            android:background="@drawable/selector_input"
            android:focusable="true"
            android:layout_width="@dimen/dp_320"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_10"
            android:text=""
            android:hint="请二次输入密码"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_cursor"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_btn_yes"
                android:background="@drawable/bg_btn1"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="确定"
                android:paddingStart="@dimen/dp_22"
                android:paddingEnd="@dimen/dp_22"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_btn_reset"
                android:background="@drawable/bg_btn1"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重置"
                android:paddingStart="@dimen/dp_22"
                android:paddingEnd="@dimen/dp_22"
                android:layout_marginStart="@dimen/dp_16"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/btn_text_color1"
                android:id="@+id/v_btn_no"
                android:background="@drawable/bg_btn1"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消"
                android:paddingStart="@dimen/dp_22"
                android:paddingEnd="@dimen/dp_22"
                android:layout_marginStart="@dimen/dp_16"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
