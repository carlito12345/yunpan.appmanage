<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/dp_10">
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:orientation="horizontal"
        android:id="@+id/v_list_top"
        android:focusable="true"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_6"/>
    <View
        android:id="@+id/v_view1"
        android:background="@color/color_2"
        android:padding="@dimen/dp_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_list_top"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:orientation="horizontal"
        android:id="@+id/v_list_cb"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/dp_130"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_6"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_view1"/>
    <View
        android:id="@+id/v_view2"
        android:background="@color/color_2"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_list_cb"
        app:layout_constraintTop_toBottomOf="@+id/v_view1"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:orientation="horizontal"
        android:id="@+id/v_list_key"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/dp_130"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_6"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_view2"
        app:layout_constraintTop_toBottomOf="@+id/v_view1"/>
    <View
        android:id="@+id/v_view3"
        android:background="@color/color_2"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_list_key"
        app:layout_constraintTop_toBottomOf="@+id/v_view1"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:orientation="horizontal"
        android:id="@+id/v_list_map"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_6"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_view3"
        app:layout_constraintTop_toBottomOf="@+id/v_view1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
