<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/dp_8">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/v_list_gn"
        android:background="#00000000"
        android:padding="@dimen/dp_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_10"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/v_loading"
        android:padding="@dimen/dp_4"
        android:focusable="false"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:indeterminateOnly="true"
        android:indeterminateDrawable="@drawable/anim_loading"
        android:indeterminateBehavior="repeat"
        app:layout_constraintBottom_toBottomOf="@+id/v_list_gn"
        app:layout_constraintStart_toEndOf="@+id/v_list_gn"
        app:layout_constraintTop_toTopOf="@+id/v_list_gn"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_13"
        android:id="@+id/v_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="一键授予此应用所有权限"
        app:layout_constraintBottom_toBottomOf="@+id/v_list_gn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_list_gn"
        app:layout_constraintTop_toTopOf="@+id/v_list_gn"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:scrollbarThumbVertical="@drawable/scrollbar1"
        android:id="@+id/v_list_permissions"
        android:background="#00000000"
        android:padding="@dimen/dp_14"
        android:focusable="true"
        android:scrollbars="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_list_gn"
        app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
        app:tv_verticalSpacingWithMargins="@dimen/dp_10"/>
</androidx.constraintlayout.widget.ConstraintLayout>
