<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_16"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_40"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_100"
        android:layout_marginEnd="@dimen/dp_100"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_13"
            android:id="@+id/v_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="拷贝到"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:orientation="horizontal"
            android:id="@+id/v_sd"
            android:focusable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_title"
            app:layout_constraintEnd_toStartOf="@+id/v_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_title"
            app:tv_horizontalSpacingWithMargins="0dp"
            app:tv_layoutManager="V7LinearLayoutManager"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="0dp"/>
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:orientation="horizontal"
            android:id="@+id/v_path"
            android:focusable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:minHeight="@dimen/dp_30"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_title"
            app:tv_horizontalSpacingWithMargins="0dp"
            app:tv_layoutManager="V7LinearLayoutManager"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="0dp"/>
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:scrollbarThumbVertical="@drawable/scrollbar1"
            android:id="@+id/v_file"
            android:background="#00000000"
            android:focusable="true"
            android:scrollbars="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_8"
            app:layout_constraintBottom_toTopOf="@+id/v_btn_yes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_path"
            app:tv_horizontalSpacingWithMargins="@dimen/dp_6"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/dp_6"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/v_read_ts_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/v_file"
            app:layout_constraintEnd_toEndOf="@+id/v_file"
            app:layout_constraintStart_toStartOf="@+id/v_file"
            app:layout_constraintTop_toTopOf="@+id/v_file">
            <ImageView
                android:id="@+id/v_read_ts_ico"
                android:layout_width="@dimen/dp_50"
                android:layout_height="@dimen/dp_50"
                android:src="@drawable/tp_noroot"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="#96fffff0"
                android:id="@+id/v_read_ts_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无权限读取此目录"
                android:maxLines="1"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/v_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/v_file"
            app:layout_constraintEnd_toEndOf="@+id/v_file"
            app:layout_constraintStart_toStartOf="@+id/v_file"
            app:layout_constraintTop_toTopOf="@+id/v_file">
            <ProgressBar
                android:layout_gravity="center"
                android:focusable="false"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/anim_loading"
                android:indeterminateBehavior="repeat"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_2"
                android:id="@+id/v_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载中"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:gravity="center"
            android:id="@+id/v_btn_reload"
            android:background="@drawable/shape_btn_focus"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="刷新"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="@+id/v_btn_yes"
            app:layout_constraintEnd_toStartOf="@+id/v_btn_yes"
            app:layout_constraintTop_toTopOf="@+id/v_btn_yes"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:gravity="center"
            android:id="@+id/v_btn_yes"
            android:background="@drawable/shape_btn_focus"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="确定"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/btn_text_color1"
            android:gravity="center"
            android:id="@+id/v_btn_new"
            android:background="@drawable/shape_btn_focus"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="新建文件夹"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/v_btn_yes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/v_btn_yes"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
