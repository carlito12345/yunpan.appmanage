<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/v_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:scrollbarThumbVertical="@drawable/scrollbar1"
        android:id="@+id/v_list"
        android:background="#00000000"
        android:padding="@dimen/dp_15"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/v_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tv_verticalSpacingWithMargins="@dimen/dp_5"/>
    <ImageView
        android:id="@+id/v_dh_bj"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_50"
        android:layout_marginBottom="@dimen/dp_30"
        android:src="@drawable/tp_clean_bg_cycle"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dp_50"
        android:layout_marginEnd="@dimen/dp_50"
        app:layout_constraintBottom_toTopOf="@+id/v_btn_yes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/v_dh_bj1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/tp_clean_big_cycle"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_dh_bj"
        app:layout_constraintEnd_toEndOf="@+id/v_dh_bj"
        app:layout_constraintStart_toStartOf="@+id/v_dh_bj"
        app:layout_constraintTop_toTopOf="@+id/v_dh_bj"/>
    <ImageView
        android:id="@+id/v_dh_bj2"
        android:padding="@dimen/dp_22"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/tp_clean_small_cycle"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_dh_bj"
        app:layout_constraintEnd_toEndOf="@+id/v_dh_bj"
        app:layout_constraintStart_toStartOf="@+id/v_dh_bj"
        app:layout_constraintTop_toTopOf="@+id/v_dh_bj"/>
    <TextView
        android:textSize="@dimen/sp_30"
        android:textColor="#ffffff"
        android:id="@+id/v_text_ts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="扫描中"
        app:layout_constraintBottom_toBottomOf="@+id/v_dh_bj"
        app:layout_constraintEnd_toEndOf="@+id/v_dh_bj"
        app:layout_constraintStart_toStartOf="@+id/v_dh_bj"
        app:layout_constraintTop_toTopOf="@+id/v_dh_bj"/>
    <TextView
        android:textSize="@dimen/sp_30"
        android:textColor="@color/btn_text_color1"
        android:id="@+id/v_btn_yes"
        android:background="@drawable/shape_btn_focus"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_20"
        android:text="扫描中"
        android:paddingStart="@dimen/dp_26"
        android:paddingEnd="@dimen/dp_26"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_guideline"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/v_btn_return"
        android:background="@drawable/wu_focus"
        android:layout_width="@dimen/dp_140"
        android:layout_height="@dimen/dp_60"
        android:text="&lt;  返回"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
