<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/v_root"
    android:background="#00000000"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/v_root2"
        android:background="@drawable/shape_dialog_first"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:scrollbarThumbVertical="@drawable/scrollbar1"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarStyle="outsideOverlay"
            android:id="@+id/v_scroll"
            android:background="@drawable/shape_noback_nofocus"
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_14"
            android:scrollbars="vertical"
            android:layout_width="@dimen/dp_600"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            android:paddingStart="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:background="@drawable/shape_noback_nofocus"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp_18"
                    android:textColor="#ffffff"
                    android:id="@+id/v_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放音频（多文件随机播放）"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_speaker"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:layout_weight="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/v_t1"
                    app:layout_constraintTop_toBottomOf="@+id/v_title">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_speaker_name"
                        android:duplicateParentState="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="默认"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/v_t1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音响设备："
                    app:layout_constraintBottom_toBottomOf="@+id/v_speaker"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_speaker"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_zhk_focus"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:layout_weight="2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/v_speaker"
                    app:layout_constraintTop_toBottomOf="@+id/v_speaker">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_zhk_focus_name"
                        android:duplicateParentState="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="无"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="独占焦点："
                    app:layout_constraintBottom_toBottomOf="@+id/v_zhk_focus"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_zhk_focus"/>
                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/v_seek_gain"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginStart="@dimen/dp_26"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/v_zhk_focus"
                    app:layout_constraintTop_toBottomOf="@+id/v_zhk_focus"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/btn_text_color1"
                    android:gravity="center_vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音量增益："
                    app:layout_constraintBottom_toBottomOf="@+id/v_seek_gain"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_seek_gain"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_2"
                    android:gravity="center_vertical"
                    android:id="@+id/v_gain"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0x"
                    app:layout_constraintBottom_toBottomOf="@+id/v_seek_gain"
                    app:layout_constraintStart_toStartOf="@+id/v_zhk_focus"
                    app:layout_constraintTop_toTopOf="@+id/v_seek_gain"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/btn_text_color1"
                    android:gravity="center_vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="修改音量："
                    app:layout_constraintBottom_toBottomOf="@+id/v_type_vol"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_type_vol"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_type_vol"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/v_speaker"
                    app:layout_constraintTop_toBottomOf="@+id/v_seek_gain">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_type_vol_name"
                        android:duplicateParentState="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="播放时修改系统音量(媒体音量)"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/btn_text_color1"
                    android:gravity="center_vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统音量："
                    app:layout_constraintBottom_toBottomOf="@+id/v_seek"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_seek"/>
                <TextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_2"
                    android:gravity="center_vertical"
                    android:id="@+id/v_vol"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    app:layout_constraintBottom_toBottomOf="@+id/v_seek"
                    app:layout_constraintStart_toStartOf="@+id/v_zhk_focus"
                    app:layout_constraintTop_toTopOf="@+id/v_seek"/>
                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/v_seek"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginStart="@dimen/dp_26"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/v_speaker"
                    app:layout_constraintTop_toBottomOf="@+id/v_type_vol"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/v_type_td"
                    android:background="@drawable/bg_installer"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layout_constraintBottom_toBottomOf="@+id/v_btn_lay"
                    app:layout_constraintStart_toEndOf="@+id/v_t1"
                    app:layout_constraintTop_toTopOf="@+id/v_btn_lay">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_type_td_name"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="通道0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:duplicateParentState="true"
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/tp_down10"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="@dimen/dp_8"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/v_type_td_name"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/btn_text_color1"
                    android:gravity="center_vertical"
                    android:duplicateParentState="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放通道："
                    app:layout_constraintBottom_toBottomOf="@+id/v_type_td"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/v_type_td"/>
                <LinearLayout
                    android:id="@+id/v_btn_lay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_seek">
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_btn_xz"
                        android:background="@drawable/bg_btn1"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选择"
                        android:paddingStart="@dimen/dp_18"
                        android:paddingEnd="@dimen/dp_18"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_btn_bf"
                        android:background="@drawable/bg_btn1"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="试听"
                        android:paddingStart="@dimen/dp_18"
                        android:paddingEnd="@dimen/dp_18"
                        android:layout_marginStart="@dimen/dp_6"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/btn_text_color1"
                        android:id="@+id/v_btn_yes"
                        android:background="@drawable/bg_btn1"
                        android:paddingTop="@dimen/dp_12"
                        android:paddingBottom="@dimen/dp_12"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="确定"
                        android:paddingStart="@dimen/dp_18"
                        android:paddingEnd="@dimen/dp_18"
                        android:layout_marginStart="@dimen/dp_6"/>
                </LinearLayout>
                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:scrollbarThumbVertical="@drawable/scrollbar1"
                    android:id="@+id/v_list"
                    android:background="@drawable/shape_list_bk"
                    android:padding="@dimen/dp_6"
                    android:focusable="true"
                    android:scrollbars="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_160"
                    android:layout_marginTop="@dimen/dp_10"
                    android:scrollbarFadeDuration="0"
                    android:scrollbarDefaultDelayBeforeFade="0"
                    android:fadeScrollbars="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_btn_lay"
                    app:tv_horizontalSpacingWithMargins="@dimen/dp_6"
                    app:tv_verticalSpacingWithMargins="@dimen/dp_6"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
