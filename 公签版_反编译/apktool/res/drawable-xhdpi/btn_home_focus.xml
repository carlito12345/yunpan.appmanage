<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/dp_660" />
            <solid android:color="#ffffffff" />
            <stroke android:width="@dimen/dp_2" android:color="@color/color_6" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/dp_660" />
            <solid android:color="@color/color_9" />
            <stroke android:width="@dimen/dp_2" android:color="@color/color_6" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape>
            <corners android:radius="@dimen/dp_660" />
            <solid android:color="#003d3d3d" />
            <stroke android:width="@dimen/dp_2" android:color="#66ffffff" />
        </shape>
    </item>
</selector>
