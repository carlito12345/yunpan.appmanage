<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/dp_10" />
            <solid android:color="#ffeee8ef" />
            <stroke android:width="@dimen/dp_2" android:color="#fffa4200" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/dp_10" />
            <solid android:color="@color/color_9" />
            <stroke android:width="@dimen/dp_2" android:color="#ffffd700" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape>
            <solid android:color="#ffeee8ef" />
        </shape>
    </item>
</selector>
