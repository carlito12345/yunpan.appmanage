<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/dp_15" />
            <solid android:color="#00000000" />
            <stroke android:width="@dimen/dp_2" android:color="#ffffffff" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/dp_15" />
            <solid android:color="@color/color_3" />
            <stroke android:width="@dimen/dp_2" android:color="@color/color_3" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape>
            <corners android:radius="@dimen/dp_15" />
            <solid android:color="#09ffffff" />
        </shape>
    </item>
</selector>
