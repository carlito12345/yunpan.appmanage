<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/dp_10" />
            <solid android:color="@color/color_9" />
            <stroke android:width="@dimen/dp_2" android:color="@color/color_6" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/dp_10" />
            <stroke android:width="@dimen/dp_2" android:color="#ffffff00" />
            <solid android:color="#983d3d3d" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="@dimen/dp_10" />
            <stroke android:width="@dimen/dp_1" android:color="#66ffffff" />
            <solid android:color="#733d3d3d" />
        </shape>
    </item>
</selector>
