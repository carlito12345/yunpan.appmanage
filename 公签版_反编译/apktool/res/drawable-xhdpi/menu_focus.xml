<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/dp_20" />
            <solid android:color="@color/color_6" />
            <gradient android:startColor="@color/color_6" android:endColor="#ffe14b08" android:angle="0.0" android:type="linear" android:centerColor="#ffe1aa00" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/dp_20" />
            <solid android:color="@color/color_6" />
            <gradient android:startColor="@color/color_6" android:endColor="#ffe14b08" android:angle="0.0" android:type="linear" android:centerColor="#ffe1aa00" />
        </shape>
    </item>
</selector>
